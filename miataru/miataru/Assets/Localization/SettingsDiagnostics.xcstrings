    "decoding_error": {
      "comment": "Error processing the server response.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke hente enhedens placeringsdata fra Miataru-serveren. Enheden findes muligvis ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortdaten des Geräts konnten nicht vom Miataru-Server abgerufen werden. Das Gerät existiert möglicherweise nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not get device location data from the Miataru server. Device might not exist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron obtener los datos de ubicación del dispositivo del servidor Miataru. Puede que el dispositivo no exista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voitu hakea laitteen sijaintidataa Miataru-palvelimelta. Laite ei ehkä ole olemassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’obtenir les données de localisation de l’appareil depuis le serveur Miataru. L’appareil n’existe peut-être pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ottenere i dati di posizione dal server Miataru. Il dispositivo potrebbe non esistere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruサーバーからデバイスの位置情報を取得できませんでした。デバイスが存在しない可能性があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen apparaatlocatiegegevens van de Miataru-server ophalen. Apparaat bestaat mogelijk niet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 Miataru 服务器获取设备位置数据。设备可能不存在。"
          }
        }
      }
    },
