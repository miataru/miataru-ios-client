    "Records selected location-tracking decisions for later export. Existing entries remain until cleared.": {
      "comment": "A description of the location diagnostics feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer udvalgte beslutninger om positionssporing til senere eksport. Eksisterende poster bevares, indtil de ryddes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet ausgewählte Entscheidungen der Standortverfolgung für den späteren Export auf. Vorhandene Einträge bleiben erhalten, bis sie gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records selected location-tracking decisions for later export. Existing entries remain until cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra decisiones seleccionadas del seguimiento de ubicación para exportarlas más tarde. Las entradas existentes se conservan hasta que se borren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa valitut sijainninseurannan päätökset myöhempää vientiä varten. Olemassa olevat merkinnät säilyvät, kunnes ne tyhjennetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre certaines décisions de suivi de localisation pour une exportation ultérieure. Les entrées existantes restent conservées jusqu’à leur suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra decisioni selezionate del tracciamento posizione per esportarle in seguito. Le voci esistenti restano finché non vengono cancellate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後でエクスポートできるように、選択された位置追跡の判断を記録します。既存のエントリは消去するまで保持されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt geselecteerde beslissingen voor locatietracking vast voor latere export. Bestaande vermeldingen blijven bewaard totdat ze worden gewist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录选定的位置跟踪决策，以便稍后导出。现有条目会保留，直到被清除。"
          }
        }
      }
    },
