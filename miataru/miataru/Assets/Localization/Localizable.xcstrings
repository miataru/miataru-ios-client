    "explanation_deactivate_device_lock": {
      "comment": "Explanation for deactivate device lock toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret forhindrer appen, at din enhed låser automatisk, mens Miataru er åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass das Gerät während der Nutzung dieser App automatisch gesperrt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the app will prevent your device from automatically locking while Miataru is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la app evitará que el dispositivo se bloquee automáticamente mientras Miataru está abierto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, sovellus estää laitteen lukittumisen Miatarun ollessa auki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, l’app empêchera ton appareil de se verrouiller automatiquement pendant que Miataru est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, l'app impedisce al dispositivo di bloccarsi automaticamente mentre Miataru è aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ使用中にデバイスが自動的にロックされるのを防ぎます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld voorkomt de app dat je apparaat automatisch vergrendelt terwijl Miataru open is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Miataru 打开时将阻止设备自动锁定。"
          }
        }
      }
    },
