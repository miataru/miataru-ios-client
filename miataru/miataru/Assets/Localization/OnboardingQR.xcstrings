    "Your location data is stored on a server you trust. You can use the default Miataru server, or enter your own server address.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine positionsdata gemmes på en server, du har tillid til. Du kan bruge Miatarus standardserver eller indtaste din egen serveradresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Standortdaten werden auf einem Server gespeichert, dem du vertraust. Du kannst den Standard-Miataru-Server verwenden oder deine eigene Serveradresse eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location data is stored on a server you trust. You can use the default Miataru server, or enter your own server address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos de ubicación se almacenan en un servidor de confianza. Puedes usar el servidor predeterminado de Miataru o introducir la dirección de tu propio servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintitietosi tallennetaan luotettavalle palvelimelle. Voit käyttää oletus-Miataru-palvelinta tai syöttää oman palvelimen osoitteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données de localisation sont stockées sur un serveur de confiance. Tu peux utiliser le serveur Miataru par défaut ou saisir l’adresse de ton propre serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati di posizione sono archiviati su un server di cui ti fidi. Puoi usare il server predefinito di Miataru o inserire l'indirizzo del tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの位置情報は、信頼できるサーバーに保存されます。デフォルトのMiataruサーバーを使用するか、自分のサーバーアドレスを入力してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatiedata wordt opgeslagen op een server die je vertrouwt. Je kunt de standaard Miataru-server gebruiken of je eigen serveradres invoeren."
          }
        },
