    "onboarding_unknown_visitor_alerts_example_message": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"En ukendt enhed (Marias iPhone) fra Berlin har anmodet om din position\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ein unbekanntes Gerät (Marias iPhone) aus Berlin hat deine Position angefragt“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"An unknown device (Maria's iPhone) from Berlin requested your position\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Un dispositivo desconocido (iPhone de María) de Berlín solicitó tu posición\""
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Tuntematon laite (Marian iPhone) Berliinistä pyysi sijaintiasi\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Un appareil inconnu (l'iPhone de Maria) de Berlin a demandé votre position\""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Un dispositivo sconosciuto (iPhone di Maria) da Berlino ha richiesto la tua posizione\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「不明なデバイス（Maria の iPhone）がベルリンからあなたの位置情報を要求しました」"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Een onbekend apparaat (Maria's iPhone) uit Berlijn heeft je positie opgevraagd\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“来自柏林的未知设备（Maria 的 iPhone）请求了你的位置”"
          }
        }
      }
    },
