    "Miataru helps you share your (device) location with people and groups you trust.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru hjælper dig med at dele din (enheds)placering med personer og grupper, du stoler på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru hilft dir, deinen (Geräte-)Standort mit Personen und Gruppen zu teilen, denen du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru helps you share your (device) location with people and groups you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru te ayuda a compartir la ubicación de tu dispositivo con personas y grupos de confianza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru auttaa jakamaan (laitteen) sijaintisi luotettujen ihmisten ja ryhmien kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru t'aide à partager la position de ton appareil avec des personnes et des groupes de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ti aiuta a condividere la posizione (del dispositivo) con persone e gruppi di cui ti fidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruは信頼できる人やグループとデバイスの位置情報を共有するのに役立ちます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru helpt je je (apparaat)locatie te delen met mensen en groepen die je vertrouwt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 帮助你与信任的人和群组共享（设备）位置。"
          }
        }
      }
    },
    "Miataru is set up and ready.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru er sat op og klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ist eingerichtet und bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is set up and ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru está configurado y listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru on asetettu ja valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru est configuré et prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru è configurata e pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruは設定され、使用可能です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is ingesteld en klaar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 已设置完毕，准备就绪。"
          }
        }
      }
    },
