    "qr_code_explanation": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne QR-kode kan bruges til at dele enheds-id’et. Den kan scannes, når en ny enhed tilføjes i Miataru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR-Code kann verwendet werden, um die Geräte-ID zu teilen. Beim Hinzufügen eines neuen Geräts in Miataru kann er gescannt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR code can be used to share the device ID. It can be scanned when adding a new device in Miataru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código QR puede utilizarse para compartir el ID del dispositivo. Se puede escanear al añadir un nuevo dispositivo en Miataru."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä QR-koodia voidaan käyttää laite-ID:n jakamiseen. Sen voi skannata, kun Miataruun lisätään uusi laite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code QR peut être utilisé pour partager l’identifiant de l’appareil. Il peut être scanné lors de l’ajout d’un nouvel appareil dans Miataru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice QR può essere usato per condividere l’ID dispositivo. Può essere scansionato quando si aggiunge un nuovo dispositivo in Miataru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRコードはデバイスIDの共有に使用できます。Miataruで新しいデバイスを追加するときにスキャンできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze QR-code kan worden gebruikt om de apparaat-ID te delen. Hij kan worden gescand bij het toevoegen van een nieuw apparaat in Miataru."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二维码可用于分享设备 ID。在 Miataru 中添加新设备时可以扫描它。"
          }
        }
      }
    },
    "Scan a QR-Code from another device running Miataru.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan en QR-kode fra en anden enhed, der kører Miataru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne einen QR-Code eines anderen Geräts mit Miataru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a QR code from another device running Miataru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un código QR de otro dispositivo que use Miataru."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa QR-koodi toisesta Miataru-laitteesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne un code QR depuis un autre appareil utilisant Miataru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona un QR code da un altro dispositivo con Miataru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruを実行している別のデバイスのQRコードをスキャンしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan een QR-code van een ander apparaat met Miataru."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
