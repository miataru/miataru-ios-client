    "Miataru helps you share your (device) location with people and groups you trust.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Miataru kan du dele din position og se positionen for enheder, du tilføjer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Miataru kannst du deinen Standort teilen und die Standorte hinzugefügter Geräte sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru lets you share your location and see the locations of devices you add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru te permite compartir tu ubicación y ver la de los dispositivos que añadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miatarulla voit jakaa sijaintisi ja nähdä lisäämiesi laitteiden sijainnit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru te permet de partager ta position et de voir celle des appareils que tu ajoutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ti permette di condividere la tua posizione e vedere quella dei dispositivi che aggiungi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruでは自分の位置情報を共有し、追加したデバイスの位置を確認できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Miataru kun je je locatie delen en de locaties zien van apparaten die je toevoegt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 可让你共享自己的位置，并查看已添加设备的位置。"
          }
        }
      }
    },
    "Miataru is set up and ready.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru er sat op og klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ist eingerichtet und bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is set up and ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru está configurado y listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru on asetettu ja valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru est configuré et prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru è configurata e pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruは設定され、使用可能です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is ingesteld en klaar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 已设置完毕，准备就绪。"
          }
        }
      }
    },
