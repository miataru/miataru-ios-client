    "qr_code_explanation": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bruge denne QR-kode til at dele din enheds-ID med andre. Scan den, når du tilføjer en ny enhed i Miataru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diesen QR-Code verwenden, um deine Geräte-ID mit anderen zu teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can use this QR-Code to share your Device ID with others. Just scan it while adding a new device in Miataru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes usar este código QR para compartir tu ID de dispositivo con otros. Solo escanéalo al añadir un nuevo dispositivo en Miataru."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit käyttää tätä QR-koodia laite-ID:n jakamiseen muiden kanssa. Skannaa se lisätessäsi uutta laitetta Miataruun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux utiliser ce code QR pour partager ton identifiant d’appareil avec d’autres. Scanne-le lors de l’ajout d’un nouvel appareil dans Miataru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi usare questo QR code per condividere il tuo ID dispositivo con altri. Scansionalo mentre aggiungi un nuovo dispositivo in Miataru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRコードを使用して、デバイスIDを他の人と共有できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze QR-code gebruiken om je apparaat-ID met anderen te delen. Scan hem bij het toevoegen van een nieuw apparaat in Miataru."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以用此二维码与他人分享设备 ID。在 Miataru 添加新设备时扫描即可。"
          }
        }
      }
    },
    "Scan a QR-Code from another device running Miataru.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan en QR-kode fra en anden enhed, der kører Miataru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne einen QR-Code eines anderen Geräts mit Miataru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a QR-Code from another device running Miataru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un código QR de otro dispositivo que use Miataru."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa QR-koodi toisesta Miataru-laitteesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez un code QR depuis un autre appareil utilisant Miataru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona un QR code da un altro dispositivo con Miataru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruを実行している別のデバイスのQRコードをスキャンしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan een QR-code van een ander apparaat met Miataru."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
