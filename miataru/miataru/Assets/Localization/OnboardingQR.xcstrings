    "Your data is only sent when you specifically activate it": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din position sendes kun, når du slår sporing til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wird nur gesendet, wenn du Tracking aktivierst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is sent only when you turn on tracking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación solo se envía cuando activas el seguimiento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintisi lähetetään vain, kun otat seurannan käyttöön"
