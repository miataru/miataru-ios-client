    "onboarding_unknown_visitor_alerts_intro_text": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru kan advare dig, når en ukendt enhed anmoder om din position."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru kann dich benachrichtigen, wenn ein unbekanntes Gerät deine Position anfragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru can alert you when an unknown device requests your position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru puede avisarte cuando un dispositivo desconocido solicite tu posición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru voi hälyttää, kun tuntematon laite pyytää sijaintiasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru peut t’avertir lorsqu'un appareil inconnu demande ta position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru può avvisarti quando un dispositivo sconosciuto richiede la tua posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なデバイスがあなたの位置情報を要求したときに、Miataru が通知できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru kan je waarschuwen wanneer een onbekend apparaat je positie opvraagt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当未知设备请求你的位置时，Miataru 可以提醒你。"
          }
        }
      }
    },
