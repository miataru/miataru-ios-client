      }
    },
    "Your data stays on the server you choose for the time you choose": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg serveren, og hvor længe den skal gemme din position"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Server und wie lange er deinen Standort speichern soll"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the server and how long it should keep your location"
          }
        },
        "es": {
