    "frequent_background_visitor_check_1m_explanation": {
      "comment": "Explanation for one-minute visitor-history checks in frequent background mode",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I den hyppigere baggrundstilstand hentes visitorhistorikken højst én gang i minuttet. Lokationsuploads følger fortsat serverens sendeindstilling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im häufigeren Hintergrundmodus wird die Besucherhistorie höchstens einmal pro Minute abgefragt. Standort-Uploads laufen weiter gemäß der Sendeeinstellung zum Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In frequent background mode, visitor history is requested at most once every minute. Location uploads continue according to the server-delivery setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo frecuente en segundo plano, el historial de visitantes se solicita como máximo una vez por minuto. Las cargas de ubicación siguen la opción de envío al servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiheämmässä taustatilassa vierailijahistoria haetaan enintään kerran minuutissa. Sijaintilähetykset noudattavat edelleen palvelimelle lähettämisen asetusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode arrière-plan fréquent, l’historique des visiteurs est demandé au plus une fois par minute. Les envois de position suivent toujours le réglage d’envoi au serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella modalità frequente in background, la cronologia visitatori viene richiesta al massimo una volta al minuto. Gli invii della posizione seguono ancora l’impostazione di invio al server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より頻繁なバックグラウンドモードでは、訪問者履歴の取得は最大でも1分に1回です。位置情報のアップロードはサーバー送信設定に従います。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de frequentere achtergrondmodus wordt de bezoekersgeschiedenis hoogstens eenmaal per minuut opgevraagd. Locatie-uploads blijven de serververzendinstelling volgen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在更频繁的后台模式下，访客历史最多每分钟请求一次。位置上传仍会遵循服务器发送设置。"
          }
        }
      }
    },
