    "smart_frequent_background_activated_notification_body": {
      "comment": "Notification body explaining that movement activated smart frequent background tracking",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru registrerede bevægelse og skiftede midlertidigt til hyppige baggrundsopdateringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru hat Bewegung erkannt und vorübergehend auf häufige Hintergrundupdates umgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
