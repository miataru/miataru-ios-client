    "explanation_auto_refresh_device_list": {
      "comment": "Explanation for auto refresh device list toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret opdateres enhedslisten automatisk, når en placeringsopdatering sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird die Geräteliste automatisch aktualisiert, sobald ein Standort-Update gesendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the device list will automatically refresh whenever a location update is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la lista de dispositivos se actualizará automáticamente cada vez que se envíe una actualización de ubicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, laitelista päivittyy automaattisesti aina, kun sijaintipäivitys lähetetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la liste des appareils se rafraîchira automatiquement à chaque envoi d’une mise à jour de position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la lista dispositivi si aggiorna automaticamente a ogni aggiornamento di posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、位置情報の更新が送信されるたびにデバイスリストが自動的に更新されます"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld wordt de apparatenlijst automatisch ververst telkens er een locatie-update wordt verzonden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，每次发送位置更新时设备列表都会自动刷新。"
          }
        }
      }
    },
    "explanation_indicate_location_accuracy": {
      "comment": "Explanation for indicate location accuracy toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret viser kortet den estimerede nøjagtighed af din aktuelle placering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, zeigt die Karte die geschätzte Genauigkeit deines aktuellen Standorts an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will display the estimated accuracy of your current location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el mapa mostrará la precisión estimada de tu ubicación actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta näyttää nykyisen sijainnin arvioidun tarkkuuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte affichera la précision estimée de ta position actuelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa mostra la precisione stimata della posizione attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、マップに現在位置の推定精度が表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld toont de kaart de geschatte nauwkeurigheid van je huidige locatie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图会显示你当前位置的估计精度。"
          }
        }
      }
    },
    "explanation_location_track": {
      "comment": "Explanation for track device location toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverer positionssporing og positionsopdateringer for denne enhed i Miataru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert die Standortverfolgung und Standortaktualisierungen für dieses Gerät in Miataru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables location tracking and location updates for this device in Miataru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el seguimiento y las actualizaciones de ubicación de este dispositivo en Miataru."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottaa käyttöön tämän laitteen sijainninseurannan ja sijaintipäivitykset Miatarussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le suivi de position et les mises à jour de position pour cet appareil dans Miataru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il tracciamento e gli aggiornamenti di posizione per questo dispositivo in Miataru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru でこのデバイスの位置追跡と位置情報更新を有効にします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt locatietracking en locatie-updates voor dit apparaat in Miataru in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此设备启用 Miataru 中的位置跟踪和位置更新。"
          }
        }
      }
    },
    "explanation_location_update_outbox_policy": {
      "comment": "Explanation for the local outbox retention and capacity controls",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrer, hvor længe og hvor mange usendte placeringsopdateringer der gemmes lokalt, før de sendes igen. Højere værdier bruger mere lagerplads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie lange und wie viele nicht gesendete Standort-Updates lokal gespeichert werden, bevor sie erneut gesendet werden. Höhere Werte benötigen mehr Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how long and how many unsent location updates are stored locally before they are sent again. Higher values use more storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla durante cuánto tiempo y cuántas actualizaciones de ubicación no enviadas se guardan localmente antes de volver a enviarlas. Los valores más altos usan más almacenamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, kuinka kauan ja kuinka monta lähettämätöntä sijaintipäivitystä säilytetään paikallisesti ennen uutta lähetystä. Suuremmat arvot käyttävät enemmän tallennustilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la durée et le nombre de mises à jour de position non envoyées conservées localement avant un nouvel envoi. Des valeurs plus élevées utilisent plus de stockage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla per quanto tempo e quante posizioni non inviate vengono conservate localmente prima di ritentare l’invio. Valori più alti usano più spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信の位置情報更新を再送信までローカルに保存する期間と件数を制御します。値を大きくするとストレージ使用量が増えます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoe lang en hoeveel niet-verzonden locatie-updates lokaal worden bewaard voordat ze opnieuw worden verzonden. Hogere waarden gebruiken meer opslagruimte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制未发送的位置更新在重新发送前在本地保存多久以及保存多少条。较高的值会占用更多存储空间。"
          }
        }
      }
    },
    "explanation_map_type": {
      "comment": "Explanation for map type picker",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrer kortets grundstil mellem standard-, hybrid- og satellitvisning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert den Grundstil der Karte zwischen Standard-, Hybrid- und Satellitenansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the base map style between default, hybrid, and satellite views."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el estilo base del mapa entre las vistas predeterminada, híbrida y satelital."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaa kartan perusnäkymän oletus-, hybridi- ja satelliittinäkymän välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change le style de base de la carte entre les vues standard, hybride et satellite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia lo stile base della mappa tra vista predefinita, ibrida e satellitare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の基本スタイルを標準、ハイブリッド、衛星表示の間で切り替えます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigt de basiskaartstijl tussen standaard-, hybride- en satellietweergave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在默认、混合和卫星视图之间切换基础地图样式。"
          }
        }
      }
    },
    "explanation_map_update_interval": {
      "comment": "Explanation for map update interval picker",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrer, hvor ofte positioner opdateres, mens et enheds- eller gruppekort er synligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie oft Standorte aktualisiert werden, während eine Geräte- oder Gruppenkarte sichtbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how often locations are refreshed while a device or group map is visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla la frecuencia con la que se actualizan las ubicaciones mientras un mapa de dispositivo o grupo está visible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, kuinka usein sijainteja päivitetään, kun laite- tai ryhmäkartta on näkyvissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle la fréquence d’actualisation des positions lorsqu’une carte d’appareil ou de groupe est visible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la frequenza con cui le posizioni vengono aggiornate quando è visibile una mappa di dispositivo o di gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスマップまたはグループマップが表示されている間の位置更新頻度を制御します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoe vaak locaties worden vernieuwd terwijl een apparaat- of groepskaart zichtbaar is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制设备地图或群组地图可见时刷新位置的频率。"
          }
        }
      }
    },
    "explanation_map_zoom_level": {
      "comment": "Explanation for map zoom level picker",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver standard-zoomafstanden, når et kort åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Standard-Zoomdistanz beim Öffnen einer Karte fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defines the default zoom distance when a map is opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define la distancia de zoom predeterminada al abrir un mapa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää oletuszoomausetäisyyden karttaa avattaessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la distance de zoom par défaut à l’ouverture d’une carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Definisce la distanza di zoom predefinita quando viene aperta una mappa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を開いたときのデフォルトのズーム距離を定義します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt de standaard zoomafstand wanneer een kaart wordt geopend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定义打开地图时的默认缩放距离。"
          }
        }
      }
    },
    "explanation_navigation_auto_route_update": {
      "comment": "If enabled, the app will automatically recalculate the route while navigating when significant movement is detected.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret beregnes ruten automatisk igen under navigation ved væsentlig bevægelse. Kan også skiftes med et langt tryk på genindlæs-knappen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird während der Navigation die Route bei signifikanter Bewegung automatisch neu berechnet. Es kann während der Navigation durch langen Druck auf den Neuladen-Button umgeschaltet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the route will be recalculated automatically during navigation when significant movement is detected. It can also be toggled via a long press on the reload button while navigating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la ruta se recalculará automáticamente durante la navegación cuando se detecte un movimiento significativo. También se puede activar con una pulsación larga en el botón de recarga durante la navegación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, reitti lasketaan navigoinnin aikana uudelleen merkittävän liikkeen jälkeen. Vaihda myös pitkäpainamalla päivitä-painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, l’itinéraire sera recalculé automatiquement pendant la navigation lorsqu’un mouvement significatif est détecté. Peut aussi être activé par un appui long sur le bouton de rechargement pendant la navigation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, il percorso viene ricalcolato automaticamente durante la navigazione quando viene rilevato un movimento significativo. Puoi anche attivarlo con una pressione prolungata sul pulsante di ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ナビゲーション中に大きな移動が検出された場合、ルートが自動的に再計算されます。ナビゲーション中にリロードボタンを長押しすることで切り替え可能です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld wordt tijdens navigatie de route automatisch herberekend bij significante beweging. Kan ook met een lange druk op de herlaadknop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，导航时检测到显著移动会自动重新计算路线。导航时长按刷新按钮也可切换。"
          }
        }
      }
    },
    "explanation_navigation_mode": {
      "comment": "Explanation on the navigation mode selection",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver den transportform, der bruges til ruteberegning og rutevejledning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt das Transportmittel für die Routenberechnung und Routenführung fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the transport mode used for route calculation and route guidance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define el modo de transporte utilizado para calcular y guiar la ruta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää kulkutavan, jota käytetään reitin laskentaan ja reittiohjaukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le mode de transport utilisé pour le calcul d’itinéraire et le guidage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la modalità di trasporto usata per il calcolo del percorso e la guida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルート計算と案内に使用する移動手段を設定します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt de vervoerswijze die wordt gebruikt voor routeberekening en routebegeleiding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置用于路线计算和路线引导的出行方式。"
          }
        }
      }
    },
    "explanation_outside_map_update_interval": {
      "comment": "Explanation for outside map update interval picker",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrer, hvor ofte enhedsdata opdateres uden for kortskærme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie oft Gerätedaten außerhalb von Kartenansichten aktualisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how often device data is refreshed outside map screens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla la frecuencia con la que se actualizan los datos de los dispositivos fuera de las pantallas de mapas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, kuinka usein laitetiedot päivitetään karttanäkymien ulkopuolella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle la fréquence d’actualisation des données des appareils en dehors des écrans cartographiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la frequenza con cui i dati dei dispositivi vengono aggiornati fuori dalle schermate della mappa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図画面以外でデバイスデータを更新する頻度を制御します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoe vaak apparaatgegevens buiten kaartschermen worden vernieuwd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制在地图界面之外刷新设备数据的频率。"
          }
        }
      }
    },
    "explanation_prevent_screen_rotation": {
      "comment": "Explanation for prevent screen rotation toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret låser appen den aktuelle skærmretning og roterer ikke ved drejning af enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, behält die App die aktuelle Bildschirmausrichtung bei und rotiert nicht beim Drehen des Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the app keeps the current screen orientation and does not rotate when the device is turned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la app mantiene la orientación actual de la pantalla y no rota al girar el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun käytössä, sovellus säilyttää nykyisen näytön suunnan eikä kierry, vaikka laitetta käännetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, l’app conserve l’orientation actuelle de l’écran et ne pivote pas lorsque l’appareil est tourné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, l'app mantiene l'orientamento attuale dello schermo e non ruota quando il dispositivo viene girato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、アプリは現在の画面向きを維持し、端末を回転しても画面は回転しません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld behoudt de app de huidige schermoriëntatie en draait niet mee wanneer het apparaat wordt gedraaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，应用将保持当前屏幕方向，即使旋转设备也不会旋转界面。"
          }
        }
      }
    },
    "explanation_pulsating_map_markers": {
      "comment": "Explanation for pulsating map markers toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret viser kortmarkører en subtil pulserende og glimtende animation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, zeigen Kartenmarkierungen eine dezente pulsierende und schimmernde Animation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, map markers will show a subtle pulsating and shimmering animation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, los marcadores del mapa mostrarán una animación sutil de pulso y brillo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, karttamerkit näyttävät hienovaraisen pulssi- ja kimmellysanimaation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, les marqueurs de carte afficheront une animation subtile de pulsation et de scintillement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, i marker della mappa mostreranno una leggera animazione pulsante e scintillante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、マップマーカーに控えめな鼓動およびシマーのアニメーションが表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld tonen kaartmarkeringen een subtiele puls- en glimeffect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图标记将显示轻微脉冲和闪光动画。"
          }
        }
      }
    },
    "explanation_reverse_geocoding_threshold": {
      "comment": "Explanation for reverse geocoding distance threshold",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindste afstandsændring før adressen opdateres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab welcher Distanzänderung die Adresse neu ermittelt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum distance change before address is refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio mínimo de distancia antes de actualizar la dirección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähimmäismatkan muutos ennen osoitteen päivitystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changement de distance minimal avant la mise à jour de l’adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanza minima di cambiamento prima di aggiornare l'indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小距離変化でアドレス更新"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimale afstandsverandering voordat adres wordt vernieuwd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址刷新前的最小距离变化。"
          }
        }
      }
    },
    "explanation_save_location_history_to_server": {
      "comment": "Explanation for saving location history on the server",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer positionshistorik på Miataru-serveren, så tidligere positioner fortsat er tilgængelige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert den Standortverlauf auf dem Miataru-Server, damit frühere Positionen verfügbar bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stores location history on the Miataru server so earlier positions remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el historial de ubicaciones en el servidor de Miataru para que las posiciones anteriores sigan disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa sijaintihistorian Miataru-palvelimelle, jotta aiemmat sijainnit pysyvät saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre l’historique de position sur le serveur Miataru afin que les positions précédentes restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memorizza la cronologia delle posizioni sul server Miataru, così le posizioni precedenti restano disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の位置を利用できるように、位置履歴を Miataru サーバーに保存します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat locatiegeschiedenis op de Miataru-server op zodat eerdere posities beschikbaar blijven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将位置历史保存到 Miataru 服务器，以便较早的位置仍可用。"
          }
        }
      }
    },
    "explanation_show_current_speed_on_map": {
      "comment": "Explanation for showing current speed on the map toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når slået til vises en enheds aktuelle hastighed (hvis >10) over markøren på kortet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird die aktuelle Geschwindigkeit eines Geräts (wenn >10) über dem Marker auf der Karte angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the current speed of a device will be shown (if >10) above the marker on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, se mostrará la velocidad actual de un dispositivo (si >10) sobre el marcador en el mapa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun käytössä, laitteen nykyinen nopeus näytetään (jos >10) kartan merkinnän yläpuolella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la vitesse actuelle d’un appareil est affichée (si >10) au-dessus du repère sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivato, la velocità attuale di un dispositivo verrà mostrata (se >10) sopra il marker sulla mappa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンの場合、デバイスの現在速度が（>10 の場合）マップ上のマーカーの上に表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld wordt de huidige snelheid van een apparaat (als >10) boven de markering op de kaart weergegeven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，将在地图上的标记上方显示设备当前速度（如果 >10）。"
          }
        }
      }
    },
    "explanation_show_offscreen_arrows_for_other_devices": {
      "comment": "Explanation for show offscreen arrows for other devices toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret viser kortet pile til andre kendte enheder uden for det synlige område. Når de er synlige, vises de på kortet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden auf der Karte Pfeile angezeigt, die auf andere bekannte Geräte zeigen, die sich außerhalb des sichtbaren Bereichs befinden. Wenn sich diese Geräte im sichtbaren Bereich befinden, werden sie auf der Karte angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will show arrows pointing to other known devices that are located outside the visible area. When these devices are in the visible area they will be shown on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el mapa mostrará flechas que apuntan a otros dispositivos conocidos situados fuera del área visible. Cuando estén dentro del área visible se mostrarán en el mapa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta näyttää nuolet muihin tunnetuihin laitteisiin näkyvän alueen ulkopuolella. Näkyvissä ollessaan ne näytetään kartalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte affichera des flèches vers d’autres appareils connus situés hors de la zone visible. Quand ces appareils sont visibles, ils s’affichent sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa mostra frecce verso altri dispositivi noti fuori dall'area visibile. Quando sono visibili, appaiono sulla mappa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、マップに表示範囲外にある他の既知のデバイスを指す矢印が表示されます。それらのデバイスが表示範囲内にある場合は、地図上に表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld toont de kaart pijlen naar andere bekende apparaten buiten beeld. Binnen beeld worden ze getoond."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图会显示指向可见范围外其他已知设备的箭头；在可见范围内则显示设备。"
          }
        }
      }
    },
    "explanation_show_route_progress": {
      "comment": "Explanation for show route progress toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret farver kortet ruten for at indikere, hvor langt den anden enhed sandsynligvis er nået siden sidste opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, färbt die Karte die Route ein, um anzuzeigen, wie weit sich das andere Gerät seit seinem letzten Update wahrscheinlich bewegt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will color the route to indicate how far the other device has likely traveled since its last update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el mapa coloreará la ruta para indicar cuánto ha avanzado probablemente el otro dispositivo desde su última actualización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta värittää reitin näyttääkseen, kuinka pitkälle toinen laite on todennäköisesti edennyt viime päivityksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte colorera l’itinéraire pour indiquer jusqu’où l’autre appareil a probablement avancé depuis sa dernière mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa colorerà il percorso per indicare quanto è probabilmente avanzato l'altro dispositivo dall'ultimo aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、地図上のルートに色が付き、前回の更新以降に相手のデバイスがどれだけ移動した可能性があるかを示します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld kleurt de kaart de route om te tonen hoe ver het andere apparaat waarschijnlijk is gekomen sinds de laatste update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图会用颜色标示自上次更新以来另一设备可能前进的路程。"
          }
        }
      }
    },
    "explanation_store_history_before_autoremove": {
      "comment": "Explanation for automatic location history removal",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver, hvor længe positionshistorik beholdes før automatisk fjernelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie lange der Standortverlauf vor der automatischen Entfernung gespeichert bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defines how long location history is kept before automatic removal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define cuánto tiempo se conserva el historial de ubicaciones antes de eliminarse automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, kuinka kauan sijaintihistoria säilytetään ennen automaattista poistamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit combien de temps l’historique de position est conservé avant sa suppression automatique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Definisce per quanto tempo la cronologia delle posizioni viene conservata prima della rimozione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置履歴を自動的に削除するまでの保持期間を定義します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoe lang locatiegeschiedenis wordt bewaard voordat deze automatisch wordt verwijderd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定义位置历史在自动删除前保留多长时间。"
          }
        }
      }
    },
    "explanation_unknown_visitor_alerts_toggle": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender en notifikation, når en ukendt enhed anmoder om den aktuelle position. Den samme ukendte enhed udløser højst én notifikation hver 24. time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine Benachrichtigung, wenn ein unbekanntes Gerät die aktuelle Position anfragt. Dasselbe unbekannte Gerät löst höchstens alle 24 Stunden eine Benachrichtigung aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a notification when an unknown device requests the current position. The same unknown device triggers at most one notification every 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una notificación cuando un dispositivo desconocido solicita la posición actual. El mismo dispositivo desconocido activa como máximo una notificación cada 24 horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää ilmoituksen, kun tuntematon laite pyytää nykyistä sijaintia. Sama tuntematon laite laukaisee enintään yhden ilmoituksen 24 tunnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une notification lorsqu’un appareil inconnu demande la position actuelle. Le même appareil inconnu déclenche au maximum une notification toutes les 24 heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia una notifica quando un dispositivo sconosciuto richiede la posizione attuale. Lo stesso dispositivo sconosciuto attiva al massimo una notifica ogni 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なデバイスが現在地を要求したときに通知を送信します。同じ不明デバイスによる通知は 24 時間ごとに最大 1 回です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt een melding wanneer een onbekend apparaat de huidige locatie opvraagt. Hetzelfde onbekende apparaat activeert maximaal één melding per 24 uur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当未知设备请求当前位置时发送通知。同一未知设备最多每 24 小时触发一次通知。"
          }
        }
      }
    },
    "explanation_zoom_to_fit_for_groups": {
      "comment": "Explanation for zoom to fit for groups toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret justerer kortet automatisk zoom for at vise alle gruppemedlemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, passt die Karte den Zoom automatisch an, um alle Gruppenmitglieder gleichzeitig anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will automatically adjust the zoom to show all group members at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activé, el mapa ajustará automáticamente el zoom para mostrar a todos los miembros del grupo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta säätää zoomin automaattisesti näyttämään kaikki ryhmän jäsenet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte ajustera automatiquement le zoom pour afficher tous les membres du groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa adatterà automaticamente lo zoom per mostrare tutti i membri del gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、地図のズームが自動的に調整され、全てのグループメンバーが一度に表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld past de kaart automatisch het zoomniveau aan om alle groepsleden te tonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图将自动调整缩放以一次显示所有组成员。"
          }
        }
      }
    },
    "frequent_background_battery_auto_disable_level_explanation": {
      "comment": "Explanation for low-battery auto-disable threshold in frequent background location updates; placeholder is the localized default percentage",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard %@. Når batteriniveauet er på eller under denne værdi, slår Miataru hyppigere baggrundsopdateringer fra og vender tilbage til standard baggrundssporing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard %@. Wenn der Akkustand diesen Wert erreicht oder darunter fällt, deaktiviert Miataru die häufigeren Hintergrund-Updates und nutzt wieder das normale Hintergrund-Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default %@. When the battery level is at or below this value, Miataru turns off more frequent background updates and returns to standard background tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado: %@. Cuando el nivel de batería está en este valor o por debajo, Miataru desactiva las actualizaciones en segundo plano más frecuentes y vuelve al seguimiento en segundo plano estándar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletus %@. Kun akun taso on tämä arvo tai sen alle, Miataru poistaa tiheämmät taustapäivitykset käytöstä ja palaa normaaliin taustaseurantaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut %@. Lorsque le niveau de batterie atteint cette valeur ou passe en dessous, Miataru désactive les mises à jour en arrière-plan plus fréquentes et revient au suivi en arrière-plan standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito %@. Quando il livello della batteria raggiunge questo valore o scende al di sotto, Miataru disattiva gli aggiornamenti in background più frequenti e torna al tracciamento in background standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトは%@です。バッテリー残量がこの値以下になると、Miataru はより頻繁なバックグラウンド更新をオフにし、標準のバックグラウンド追跡に戻ります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard %@. Wanneer het batterijniveau op of onder deze waarde komt, schakelt Miataru frequentere achtergrondupdates uit en keert terug naar standaard achtergrondtracking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 %@。当电量达到或低于此值时，Miataru 会关闭更频繁的后台更新，并返回标准后台跟踪。"
          }
        }
      }
    },
