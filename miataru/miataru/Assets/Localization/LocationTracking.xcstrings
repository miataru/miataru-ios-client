    "smart_frequent_background_inactivity_window_explanation": {
      "comment": "Explanation for smart frequent inactivity window",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard er 10 minutter. Smart stopper hyppigere opdateringer, hvis der ikke kommer en position, eller hvis der ikke registreres relevant bevægelse inden for dette tidsrum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard sind 10 Minuten. Smart stoppt häufigere Updates, wenn in diesem Zeitraum kein Standort kommt oder keine relevante Bewegung erkannt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default is 10 minutes. Smart stops more frequent updates if no location arrives or no relevant movement is detected within this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor predeterminado es 10 minutos. Smart detiene las actualizaciones más frecuentes si no llega ninguna ubicación o no se detecta movimiento relevante durante este intervalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletus on 10 minuuttia. Smart pysäyttää tiheämmät päivitykset, jos sijaintia ei tule tai olennaista liikettä ei havaita tämän ajan kuluessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur par défaut est 10 minutes. Smart arrête les mises à jour plus fréquentes si aucune position n’arrive ou si aucun déplacement pertinent n’est détecté pendant cette période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore predefinito è 10 minuti. Smart interrompe gli aggiornamenti più frequenti se non arriva alcuna posizione o non viene rilevato movimento rilevante entro questo intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトは 10 分です。この時間内に位置情報が届かない、または有意な移動が検出されない場合、Smart は頻繁な更新を停止します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard is 10 minuten. Smart stopt frequentere updates als er binnen dit venster geen locatie binnenkomt of geen relevante beweging wordt gedetecteerd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认值为 10 分钟。如果在此时间内没有位置更新，或未检测到相关移动，Smart 会停止更频繁的更新。"
          }
        }
      }
    },
