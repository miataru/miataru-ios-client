    "smart_frequent_background_waiting_hint": {
      "comment": "Hint shown when smart frequent background updates are waiting for movement",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart frequent venter på bevægelse over hastighedsgrænsen, mens Miataru bruger den strømbesparende standardtilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Frequent wartet auf Bewegung über der Geschwindigkeitsschwelle, während Miataru den stromsparenden Standardmodus nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart frequent is waiting for movement above the speed threshold while Miataru uses the battery-saving standard mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart frequent espera movimiento por encima del umbral de velocidad mientras Miataru usa el modo estándar de ahorro de batería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älykäs tiheä päivitys odottaa nopeusrajan ylittävää liikettä, kun Miataru käyttää akkua säästävää vakiotilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour fréquentes intelligentes attendent un déplacement au-dessus du seuil de vitesse pendant que Miataru utilise le mode standard économe en batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti frequenti intelligenti attendono un movimento sopra la soglia di velocità mentre Miataru usa la modalità standard a risparmio batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート高頻度更新は、Miataru が省電力の標準モードを使っている間、速度しきい値を超える移動を待機しています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slimme frequente updates wachten op beweging boven de snelheidsdrempel terwijl Miataru de batterijbesparende standaardmodus gebruikt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能频繁更新会在 Miataru 使用省电标准模式时等待超过速度阈值的移动。"
          }
        }
      }
    },
