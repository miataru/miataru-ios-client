      "comment": "Explanation shown when Smart frequent updates are locked because manual frequent background updates are active",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle hyppige baggrundsopdateringer er aktive. Slå dem fra, før du ændrer smarte hyppige opdateringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle häufige Hintergrund-Updates sind aktiv. Schalte sie aus, bevor du smarte häufige Updates änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual frequent background updates are active. Turn them off before changing Smart frequent updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones frecuentes manuales en segundo plano están activas. Desactívalas antes de cambiar las actualizaciones frecuentes inteligentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuaaliset tiheät taustapäivitykset ovat aktiivisia. Poista ne käytöstä ennen älykkäiden tiheiden päivitysten muuttamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour fréquentes manuelles en arrière-plan sont actives. Désactivez-les avant de modifier les mises à jour fréquentes intelligentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti frequenti manuali in background sono attivi. Disattivali prima di modificare gli aggiornamenti frequenti intelligenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動の高頻度バックグラウンド更新が有効です。スマート高頻度更新を変更する前にオフにしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handmatige frequentere achtergrondupdates zijn actief. Schakel ze uit voordat je slimme frequente updates wijzigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动频繁后台更新已启用。请先将其关闭，再更改智能频繁更新。"
          }
        }
      }
    },
    "smart_frequent_background_mode_change_notifications_explanation": {
      "comment": "Explanation for smart frequent mode-change notification toggle",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender en notifikation, når smarte hyppige opdateringer automatisk slår hyppige baggrundsopdateringer til eller skifter tilbage til standardtilstand. Standard: fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine Benachrichtigung, wenn smarte häufige Updates häufige Hintergrundupdates automatisch einschalten oder wieder in den Standardmodus wechseln. Standard: aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a notification when Smart frequent updates automatically switch frequent background updates on or back to standard mode. Default: off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una notificación cuando las actualizaciones frecuentes inteligentes activan automáticamente las actualizaciones frecuentes en segundo plano o vuelven al modo estándar. Valor predeterminado: desactivado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää ilmoituksen, kun älykkäät tiheät päivitykset ottavat tiheät taustapäivitykset automaattisesti käyttöön tai palaavat vakiotilaan. Oletus: pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une notification lorsque les mises à jour fréquentes intelligentes activent automatiquement les mises à jour fréquentes en arrière-plan ou reviennent au mode standard. Par défaut : désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia una notifica quando gli aggiornamenti frequenti smart attivano automaticamente gli aggiornamenti frequenti in background o tornano alla modalità standard. Predefinito: disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート高頻度更新がバックグラウンドの高頻度更新を自動的にオンにしたとき、または標準モードへ戻したときに通知します。デフォルト: オフ。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt een melding wanneer slimme frequente updates frequente achtergrondupdates automatisch inschakelen of teruggaan naar de standaardmodus. Standaard: uit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当智能频繁更新自动开启频繁后台更新或切回标准模式时发送通知。默认：关闭。"
          }
        }
      }
    },
