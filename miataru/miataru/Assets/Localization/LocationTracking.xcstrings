    "location_permission_open_settings_message": {
      "comment": "Explanation message when redirecting to Settings for location permission",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standorttilladelsen blev tidligere nægtet. For at aktivere standortsporing skal du åbne Indstillinger og give Miataru adgang til din placering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standortberechtigung wurde zuvor verweigert. Um die Standortverfolgung zu aktivieren, öffne bitte die Einstellungen und gewähre Miataru Zugriff auf deinen Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission was previously denied. To enable location tracking, please open Settings and grant location access to Miataru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de ubicación fue denegado anteriormente. Para habilitar el seguimiento de ubicación, abre Configuración y otorga acceso de ubicación a Miataru."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintilupa evättiin aiemmin. Ota sijainnin seuranta käyttöön avaamalla Asetukset ja myöntämällä Miatarulle sijaintipääsy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de localisation a été refusée précédemment. Pour activer le suivi de localisation, ouvrez les Réglages et accordez l'accès à la localisation à Miataru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso di posizione è stato negato in precedenza. Per abilitare il tracciamento della posizione, apri Impostazioni e concedi l'accesso alla posizione a Miataru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の許可が以前に拒否されました。位置追跡を有効にするには、設定を開いてMiataruに位置情報へのアクセスを許可してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoestemming werd eerder geweigerd. Om locatietracering in te schakelen, open Instellingen en verleen Miataru toegang tot uw locatie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置权限之前被拒绝。要启用位置跟踪，请打开设置并向 Miataru 授予位置访问权限。"
          }
        }
      }
    },
    "location_permission_open_settings_title": {
      "comment": "Alert title when redirecting to Settings for location permission",
      "localizations": {
        "da": {
