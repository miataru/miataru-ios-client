    "frequent_background_location_duration_1h_explanation": {
      "comment": "Explanation for one-hour frequent background location duration",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyppigere baggrundsopdateringer slås fra efter 1 time, og Miataru vender tilbage til den strømbesparende standardtilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufigere Hintergrund-Updates werden nach 1 Stunde ausgeschaltet, danach nutzt Miataru wieder den stromsparenden Standardmodus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequent background updates turn off after 1 hour, then Miataru returns to the battery-saving standard mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones frecuentes en segundo plano se desactivan después de 1 hora; luego Miataru vuelve al modo estándar de ahorro de batería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiheät taustapäivitykset poistuvat käytöstä 1 tunnin jälkeen, minkä jälkeen Miataru palaa akkua säästävään vakiotilaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour fréquentes en arrière-plan se désactivent après 1 heure, puis Miataru revient au mode standard économe en batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti frequenti in background si disattivano dopo 1 ora; poi Miataru torna alla modalità standard a risparmio batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間後に高頻度バックグラウンド更新をオフにし、Miataru は省電力の標準モードに戻ります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequentere achtergrondupdates worden na 1 uur uitgeschakeld, waarna Miataru terugkeert naar de batterijbesparende standaardmodus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频繁后台更新会在 1 小时 后关闭，随后 Miataru 返回省电标准模式。"
          }
        }
      }
    },
