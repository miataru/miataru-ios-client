    "frequent_background_location_duration_never_explanation": {
      "comment": "Explanation for never auto-disabling frequent background location updates",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyppigere baggrundsopdateringer forbliver aktive, indtil du slår dem fra manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufigere Hintergrund-Updates bleiben aktiv, bis du sie manuell ausschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequent background updates stay on until you turn them off manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones frecuentes en segundo plano permanecen activas hasta que las desactives manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiheämmät taustapäivitykset pysyvät käytössä, kunnes poistat ne käytöstä käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour fréquentes en arrière-plan restent actives jusqu’à ce que vous les désactiviez manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti frequenti in background restano attivi finché non li disattivi manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動でオフにするまで、より頻繁なバックグラウンド更新は有効なままです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequentere achtergrondupdates blijven actief totdat je ze handmatig uitschakelt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更频繁的后台更新会保持开启，直到你手动将其关闭。"
          }
        }
      }
    },
    "frequent_background_location_expired_notification_body": {
      "comment": "Notification body explaining that Miataru returned to standard background tracking",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den midlertidige tilstand for hyppige baggrundsopdateringer er afsluttet automatisk. Miataru bruger nu standardtilstanden for baggrundsopdateringer igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der temporäre Modus für häufige Hintergrund-Standortupdates wurde automatisch beendet. Miataru nutzt jetzt wieder den Standardmodus für Hintergrundupdates."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary frequent background location mode ended automatically. Miataru now uses the standard background update mode again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo temporal de ubicación frecuente en segundo plano terminó automáticamente. Miataru vuelve a usar el modo estándar de actualizaciones en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väliaikainen tiheä taustasijaintitila päättyi automaattisesti. Miataru käyttää nyt taas taustapäivitysten vakiotilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode temporaire de localisation fréquente en arrière-plan s’est terminé automatiquement. Miataru utilise de nouveau le mode standard des mises à jour en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità temporanea di posizione frequente in background è terminata automaticamente. Miataru usa di nuovo la modalità standard per gli aggiornamenti in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的な頻繁なバックグラウンド位置情報モードは自動的に終了しました。Miataru は再び標準のバックグラウンド更新モードを使用しています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijdelijke frequentere achtergrondlocatiemodus is automatisch beëindigd. Miataru gebruikt nu weer de standaardmodus voor achtergrondupdates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时的频繁后台位置模式已自动结束。Miataru 现在已重新使用标准后台更新模式。"
          }
        }
      }
    },
    "frequent_background_location_expired_notification_title": {
      "comment": "Notification title shown when temporary frequent background tracking has automatically ended",
      "localizations": {
        "da": {
          "stringUnit": {
