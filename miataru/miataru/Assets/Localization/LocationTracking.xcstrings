    "frequent_background_location_battery_auto_disabled_notification_body_format": {
      "comment": "Notification body explaining that low battery disabled frequent background tracking",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteriet er på %@ og har nået grænsen på %@. Miataru har slået hyppigere baggrundsopdateringer fra og bruger nu standardtilstanden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akku liegt bei %@ und hat die Grenze von %@ erreicht. Miataru hat häufigere Hintergrund-Updates deaktiviert und nutzt jetzt den Standardmodus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery is at %@ and reached the %@ limit. Miataru turned off more frequent background updates and is now using standard mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está al %@ y alcanzó el límite del %@. Miataru desactivó las actualizaciones en segundo plano más frecuentes y ahora usa el modo estándar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Akku on %@ ja saavutti %@ rajan. Miataru poisti tiheämmät taustapäivitykset käytöstä ja käyttää nyt oletustilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est à %@ et a atteint la limite de %@. Miataru a désactivé les mises à jour en arrière-plan plus fréquentes et utilise maintenant le mode standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria è al %@ e ha raggiunto il limite del %@. Miataru ha disattivato gli aggiornamenti in background più frequenti e ora usa la modalità standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量が%@になり、%@の上限に達しました。Miataru はより頻繁なバックグラウンド更新をオフにし、標準モードを使用しています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De batterij staat op %@ en heeft de grens van %@ bereikt. Miataru heeft frequentere achtergrondupdates uitgeschakeld en gebruikt nu de standaardmodus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量为 %@，已达到 %@ 限制。Miataru 已关闭更频繁的后台更新，现在使用标准模式。"
          }
        }
      }
    },
