    "frequent_background_location_delivery_immediate_explanation": {
      "comment": "Explanation for immediate frequent background location delivery",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard. Hver accepteret baggrundsopdatering sendes straks til serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard. Jedes akzeptierte Hintergrund-Update wird sofort an den Server gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default. Each accepted background update is sent to the server right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado. Cada actualización en segundo plano aceptada se envía al servidor de inmediato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletus. Jokainen hyväksytty taustapäivitys lähetetään palvelimelle heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut. Chaque mise à jour en arrière-plan acceptée est envoyée immédiatement au serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito. Ogni aggiornamento in background accettato viene inviato subito al server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準。受け入れられたバックグラウンド更新をそれぞれすぐにサーバーへ送信します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard. Elke geaccepteerde achtergrondupdate wordt meteen naar de server gestuurd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认。每个已接受的后台更新都会立即发送到服务器。"
          }
        }
      }
    },
