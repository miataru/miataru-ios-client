          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molto reattivo. Accetta aggiornamenti dopo circa 10 m e può consumare sensibilmente più batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても反応が速い設定です。約10 mの移動後に更新を受け入れ、バッテリー消費が目立って増える場合があります。"
          }
        },
        "nl": {
          "stringUnit": {
