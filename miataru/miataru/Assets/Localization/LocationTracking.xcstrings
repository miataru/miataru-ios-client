    "location_tracking_health_reminder_notification_body": {
      "comment": "Notification body explaining that Miataru should be opened after a long quiet period",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru har været stille et stykke tid. Åbn appen for at bekræfte, at lokalitetssporing stadig virker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru war eine Weile still. Öffne die App, um zu bestätigen, dass die Standortverfolgung noch funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru has been quiet for a while. Open the app to confirm location tracking is still working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ha estado en silencio durante un tiempo. Abre la app para confirmar que el seguimiento de ubicación sigue funcionando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru on ollut hiljaa jonkin aikaa. Avaa sovellus varmistaaksesi, että sijainnin seuranta toimii yhä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru est silencieuse depuis un moment. Ouvrez l’app pour confirmer que le suivi de position fonctionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru non ha dato segnali da un po’. Apri l’app per confermare che il tracciamento della posizione funzioni ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく Miataru から更新がありません。アプリを開いて位置情報トラッキングが動作していることを確認してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is al een tijdje stil. Open de app om te bevestigen dat locatietracking nog werkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 已有一段时间没有动静。打开应用以确认位置跟踪仍在工作。"
          }
        }
      }
    },
