    "background_location_distance_filter_5m_explanation": {
      "comment": "Explanation for 5 m frequent background movement threshold",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstremt responsiv. Accepterer opdateringer efter ca. 5 m og kan bruge markant mere batteri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrem reaktionsschnell. Akzeptiert Updates nach etwa 5 m und kann deutlich mehr Akku verbrauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extremely responsive. Accepts updates after about 5 m and can use significantly more battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extremadamente sensible. Acepta actualizaciones tras unos 5 m y puede consumir mucha más batería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Erittäin reagoiva. Hyväksyy päivitykset noin 5 m jälkeen ja voi kuluttaa selvästi enemmän akkua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrêmement réactif. Accepte des mises à jour après environ 5 m et peut consommer nettement plus de batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estremamente reattivo. Accetta aggiornamenti dopo circa 5 m e può consumare molta più batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に反応が速い設定です。約5 mの移動後に更新を受け入れ、バッテリー消費が大幅に増える場合があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreem responsief. Accepteert updates na ongeveer 5 m en kan aanzienlijk meer batterij gebruiken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "极高响应。移动约 5 米后接受更新，可能显著增加电量消耗。"
          }
        }
      }
    },
    "background_location_distance_filter_10m_explanation": {
      "comment": "Explanation for 10 m frequent background movement threshold",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
