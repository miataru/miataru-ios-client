            "state": "translated",
            "value": "Muy sensible. Acepta actualizaciones tras unos 10 m y puede consumir bastante más batería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvin reagoiva. Hyväksyy päivitykset noin 10 m jälkeen ja voi kuluttaa selvästi enemmän akkua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
