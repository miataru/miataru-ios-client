    "smart_frequent_background_deactivated_notification_body": {
      "comment": "Notification body explaining that inactivity stopped smart frequent background tracking",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru registrerede ikke nok nylig bevægelse eller lokalitetsopdateringer og vendte tilbage til standard baggrundssporing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru hat zuletzt nicht genug Bewegung oder Standortupdates gesehen und ist zur Standard-Hintergrundverfolgung zurückgekehrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru did not see enough recent movement or location updates and returned to standard background tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru no detectó suficiente movimiento ni actualizaciones de ubicación recientes y volvió al seguimiento estándar en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ei havainnut tarpeeksi viimeaikaista liikettä tai sijaintipäivityksiä ja palasi tavalliseen taustaseurantaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru n’a pas détecté assez de déplacements ou de mises à jour de position récents et est revenu au suivi standard en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru non ha rilevato movimento o aggiornamenti posizione recenti sufficienti ed è tornato al tracciamento standard in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru は最近十分な移動や位置情報更新を検出しなかったため、標準のバックグラウンド追跡へ戻しました。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru zag niet genoeg recente beweging of locatie-updates en is teruggegaan naar standaard achtergrondtracking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 未检测到足够的近期移动或位置更新，已返回标准后台跟踪。"
          }
        }
      }
    },
