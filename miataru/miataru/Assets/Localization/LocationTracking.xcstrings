    "smart_frequent_background_mode_change_notifications_permission_denied_message": {
      "comment": "Message shown when Smart frequent mode-change notification permission is denied",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er ikke tilladt. Åbn iOS-indstillinger for at modtage besked, når Smart hyppige opdateringer skifter tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind nicht erlaubt. Öffne die iOS-Einstellungen, um Hinweise zu erhalten, wenn smarte häufige Updates den Modus wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are not allowed. Open iOS Settings to be notified when Smart frequent updates change mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones no están permitidas. Abre Ajustes de iOS para recibir avisos cuando las actualizaciones frecuentes inteligentes cambien de modo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksia ei ole sallittu. Avaa iOS-asetukset, jotta saat ilmoituksen, kun älykkäät tiheät päivitykset vaihtavat tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont pas autorisées. Ouvrez les réglages iOS pour être averti lorsque les mises à jour fréquentes intelligentes changent de mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche non sono consentite. Apri le impostazioni iOS per ricevere avvisi quando gli aggiornamenti frequenti intelligenti cambiano modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が許可されていません。スマート高頻度更新のモード変更を通知するには、iOS設定を開いてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn niet toegestaan. Open iOS-instellingen om een melding te krijgen wanneer slimme frequente updates van modus veranderen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知未获允许。请打开 iOS 设置，以便在智能频繁更新切换模式时收到通知。"
          }
        }
      }
    },
