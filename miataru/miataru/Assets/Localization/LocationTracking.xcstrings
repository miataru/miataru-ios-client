    "location_update_outbox_server_change_message": {
      "comment": "Message shown when changing the server URL while location updates are queued",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er %d placeringsopdateringer i kø. Skal de sendes til den nye server-URL eller kasseres?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind %d Standort-Updates in der Queue. Sollen sie an die neue Server-URL gesendet oder verworfen werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are %d queued location updates. Send them to the new server URL or discard them?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %d actualizaciones de ubicación en cola. ¿Enviarlas a la nueva URL del servidor o descartarlas?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonossa on %d sijaintipäivitystä. Lähetetäänkö ne uuteen palvelimen URL-osoitteeseen vai hylätäänkö ne?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d mises à jour de position sont en attente. Les envoyer à la nouvelle URL du serveur ou les supprimer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono %d aggiornamenti di posizione in coda. Inviarli al nuovo URL del server o eliminarli?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 件の位置情報更新がキューにあります。新しいサーバー URL に送信しますか、それとも破棄しますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staan %d locatie-updates in de wachtrij. Naar de nieuwe server-URL sturen of verwijderen?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列中有 %d 条位置更新。要发送到新的服务器 URL，还是丢弃它们？"
          }
        }
      }
    },
