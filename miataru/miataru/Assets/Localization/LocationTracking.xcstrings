    "smart_frequent_background_restart_recovery_notification_body": {
      "comment": "Notification body explaining that app restart returned smart frequent background tracking to standard mode",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru blev startet igen og bruger standard baggrundssporing, indtil Smart Frequent registrerer bevægelse igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru wurde neu gestartet und nutzt wieder die Standard-Hintergrundverfolgung, bis Smart Frequent erneut Bewegung erkennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru restarted and is using standard background tracking again until Smart Frequent detects movement again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru se reinició y vuelve a usar el seguimiento estándar en segundo plano hasta que Smart Frequent detecte movimiento de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru käynnistyi uudelleen ja käyttää taas tavallista taustaseurantaa, kunnes Smart Frequent havaitsee liikettä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru a redémarré et utilise à nouveau le suivi standard en arrière-plan jusqu'à ce que Smart Frequent détecte de nouveau un déplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru è stato riavviato e usa di nuovo il tracciamento standard in background finché Smart Frequent non rileva di nuovo movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru が再起動したため、Smart Frequent が再び移動を検出するまで標準のバックグラウンド追跡を使用します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is opnieuw gestart en gebruikt weer standaard achtergrondtracking totdat Smart Frequent opnieuw beweging detecteert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 已重新启动，并再次使用标准后台跟踪，直到 Smart Frequent 再次检测到移动。"
          }
        }
      }
    },
    "smart_frequent_background_speed_detection_explanation": {
      "comment": "Explanation for smart frequent speed detection mode",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybrid bruger GPS-hastighed, når den er tilgængelig, og beregner ellers hastighed ud fra afstand og tid mellem brugbare positioner. Kun GPS bruger kun systemets hastighedsværdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybrid nutzt GPS-Speed, wenn verfügbar, und berechnet sonst Geschwindigkeit aus Distanz und Zeit zwischen brauchbaren Standorten. Nur GPS verwendet ausschließlich den System-Speed-Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybrid uses GPS speed when available and otherwise derives speed from distance and time between usable locations. GPS only uses only the system speed value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Híbrido usa la velocidad GPS cuando está disponible y, si no, calcula la velocidad a partir de la distancia y el tiempo entre ubicaciones utilizables. Solo GPS usa únicamente el valor de velocidad del sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybridi käyttää GPS-nopeutta, kun se on saatavilla, ja muuten laskee nopeuden käyttökelpoisten sijaintien etäisyydestä ja ajasta. Vain GPS käyttää vain järjestelmän nopeusarvoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybride utilise la vitesse GPS lorsqu’elle est disponible, sinon calcule la vitesse à partir de la distance et du temps entre des positions exploitables. GPS seul utilise uniquement la vitesse fournie par le système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibrido usa la velocità GPS quando disponibile e altrimenti calcola la velocità da distanza e tempo tra posizioni utilizzabili. Solo GPS usa solo il valore di velocità del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイブリッドは利用可能な場合は GPS 速度を使い、それ以外は有効な位置間の距離と時間から速度を推定します。GPS のみはシステムの速度値だけを使います。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybride gebruikt gps-snelheid wanneer beschikbaar en berekent anders snelheid uit afstand en tijd tussen bruikbare locaties. Alleen gps gebruikt alleen de systeemsnelheid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混合模式会优先使用 GPS 速度，否则根据可用位置之间的距离和时间推算速度。仅 GPS 模式只使用系统速度值。"
          }
        }
      }
    },
    "smart_frequent_background_speed_detection_gps_only": {
      "comment": "GPS-only speed detection option",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun GPS-hastighed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur GPS-Speed"
          }
        },
        "en": {
