    "frequent_background_location_updates_active_hint_format": {
      "comment": "Hint shown when frequent background updates are active",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyppigere baggrundsopdateringer er aktive. Miataru anmoder om opdateringer efter ca. %d m bevægelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufigere Hintergrund-Updates sind aktiv. Miataru fordert Updates nach etwa %d m Bewegung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequent background updates are active. Miataru requests updates after about %d m of movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones frecuentes en segundo plano están activas. Miataru solicita actualizaciones tras unos %d m de movimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiheämmät taustapäivitykset ovat käytössä. Miataru pyytää päivityksiä noin %d m liikkumisen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour fréquentes en arrière-plan sont actives. Miataru demande des mises à jour après environ %d m de déplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti frequenti in background sono attivi. Miataru richiede aggiornamenti dopo circa %d m di movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻繁なバックグラウンド更新が有効です。Miataru は約 %d m の移動後に更新を要求します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequentere achtergrondupdates zijn actief. Miataru vraagt updates aan na ongeveer %d m beweging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更频繁的后台更新已启用。Miataru 会在移动约 %d 米后请求更新。"
          }
        }
      }
    },
    "frequent_background_location_updates_battery_warning": {
