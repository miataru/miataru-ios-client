    "frequent_background_location_delivery_30s_explanation": {
      "comment": "Explanation for 30-second frequent background location delivery",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepterede opdateringer gemmes lokalt og sendes samlet, når vinduet på 30 sekunder er nået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptierte Updates werden lokal gespeichert und gemeinsam gesendet, wenn das 30-Sekunden-Fenster erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted updates are stored locally and sent together when the 30-second window is reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones aceptadas se guardan localmente y se envían juntas al cumplirse la ventana de 30 segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksytyt päivitykset tallennetaan paikallisesti ja lähetetään yhdessä, kun 30 sekunnin ikkuna täyttyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour acceptées sont conservées localement puis envoyées ensemble lorsque la fenêtre de 30 secondes est atteinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti accettati vengono salvati localmente e inviati insieme al termine della finestra di 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け入れられた更新をローカルに保存し、30秒の送信ウィンドウに達したらまとめて送信します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geaccepteerde updates worden lokaal bewaard en samen verzonden wanneer het venster van 30 seconden is bereikt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受的更新会先保存在本地，并在 30 秒窗口到达后一起发送。"
          }
        }
      }
    },
