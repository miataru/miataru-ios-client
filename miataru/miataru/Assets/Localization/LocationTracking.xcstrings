    "frequent_background_location_updates_manual_explanation": {
      "comment": "Explanation for manually enabled frequent background updates overriding smart mode",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå dette til for at holde hyppigere baggrundsopdateringer aktive med de valgte indstillinger. Denne manuelle tilstand tilsidesætter de smarte start- og stopkriterier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dies ein, um häufigere Hintergrund-Updates mit den gewählten Einstellungen aktiv zu halten. Dieser manuelle Modus überschreibt die Smart-Start- und Stoppkriterien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to keep more frequent background updates active with the selected settings. This manual mode overrides the smart start and stop criteria."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo para mantener actualizaciones en segundo plano más frecuentes con los ajustes seleccionados. Este modo manual omite los criterios inteligentes de inicio y parada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota tämä käyttöön, jotta tiheämmät taustapäivitykset pysyvät aktiivisina valituilla asetuksilla. Tämä manuaalinen tila ohittaa älykkäät käynnistys- ja pysäytysehdot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option pour garder des mises à jour en arrière-plan plus fréquentes avec les réglages choisis. Ce mode manuel remplace les critères intelligents de démarrage et d’arrêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo per mantenere aggiornamenti in background più frequenti con le impostazioni scelte. Questa modalità manuale ignora i criteri intelligenti di avvio e arresto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した設定で、より頻繁なバックグラウンド更新を維持するにはオンにします。この手動モードはスマート開始・停止条件より優先されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel dit in om frequentere achtergrondupdates actief te houden met de gekozen instellingen. Deze handmatige modus overschrijft de slimme start- en stopcriteria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后会按所选设置保持更频繁的后台更新。此手动模式会覆盖智能启动和停止条件。"
          }
        }
      }
    },
