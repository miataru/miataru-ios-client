    "location_tracking_health_reminder_interval_explanation": {
      "comment": "Explanation for the location tracking health reminder interval picker",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru minder dig om at åbne appen, hvis den ikke er blevet åbnet eller har sendt en placeringsopdatering i så lang tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru erinnert dich daran, die App zu öffnen, wenn sie so lange nicht geöffnet wurde oder keine Standortaktualisierung gesendet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru reminds you to open the app if it has not been opened or sent a location update for this long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru te recuerda abrir la app si no se ha abierto o no ha enviado una actualización de ubicación durante este tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru muistuttaa avaamaan sovelluksen, jos sitä ei ole avattu tai se ei ole lähettänyt sijaintipäivitystä tähän aikaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru vous rappelle d’ouvrir l’app si elle n’a pas été ouverte ou n’a envoyé aucune mise à jour de position pendant cette durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ti ricorda di aprire l’app se non è stata aperta o non ha inviato aggiornamenti della posizione per questo periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間 Miataru が開かれていない、または位置情報を送信していない場合に、アプリを開くよう通知します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru herinnert je eraan de app te openen als deze zo lang niet is geopend of geen locatie-update heeft verzonden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Miataru 在这段时间内未打开或未发送位置更新，它会提醒你打开应用。"
          }
        }
      }
    },
