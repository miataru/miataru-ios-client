    "smart_frequent_background_speed_threshold_explanation": {
      "comment": "Explanation for smart frequent speed threshold",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard er 10 km/t. Smart starter hyppigere opdateringer, når den registrerede hastighed når eller overstiger denne værdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard sind 10 km/h. Smart startet häufigere Updates, wenn die erkannte Geschwindigkeit diesen Wert erreicht oder überschreitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default is 10 km/h. Smart starts more frequent updates when the detected speed reaches or exceeds this value."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor predeterminado es 10 km/h. Smart inicia actualizaciones más frecuentes cuando la velocidad detectada alcanza o supera este valor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletus on 10 km/h. Smart käynnistää tiheämmät päivitykset, kun havaittu nopeus saavuttaa tai ylittää tämän arvon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur par défaut est 10 km/h. Smart lance des mises à jour plus fréquentes lorsque la vitesse détectée atteint ou dépasse cette valeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore predefinito è 10 km/h. Smart avvia aggiornamenti più frequenti quando la velocità rilevata raggiunge o supera questo valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトは 10 km/h です。検出された速度がこの値以上になると、Smart はより頻繁な更新を開始します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard is 10 km/u. Smart start frequentere updates wanneer de gedetecteerde snelheid deze waarde bereikt of overschrijdt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认值为 10 公里/小时。当检测到的速度达到或超过此值时，Smart 会启动更频繁的更新。"
          }
        }
      }
    },
