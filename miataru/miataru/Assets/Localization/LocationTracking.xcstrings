    },
    "frequent_background_location_reminder_notification_body": {
      "comment": "Notification body explaining that tapping opens Advanced Options to disable frequent background tracking",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru bruger den hyppige baggrundstilstand uden udløb. Tryk for at åbne avancerede indstillinger og slå den fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru nutzt den nie ablaufenden Modus für häufige Hintergrund-Standortupdates. Tippe, um die erweiterten Einstellungen zu öffnen und ihn auszuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is using the never-expiring frequent background location mode. Tap to open Advanced Options and turn it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru está usando el modo frecuente de ubicación en segundo plano sin caducidad. Toca para abrir las opciones avanzadas y desactivarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru käyttää päättymätöntä tiheää taustasijaintitilaa. Avaa lisäasetukset napauttamalla ja poista se käytöstä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru utilise le mode de localisation fréquent en arrière-plan sans expiration. Touchez pour ouvrir les options avancées et le désactiver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru sta usando la modalità frequente di posizione in background senza scadenza. Tocca per aprire le opzioni avanzate e disattivarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru は期限なしの頻繁なバックグラウンド位置情報モードを使用しています。タップして詳細設定を開き、オフにできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru gebruikt de frequentere achtergrondlocatiemodus zonder eindtijd. Tik om Geavanceerde opties te openen en deze uit te schakelen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 正在使用永不过期的频繁后台位置模式。轻点可打开高级选项并将其关闭。"
          }
        }
      }
    },
