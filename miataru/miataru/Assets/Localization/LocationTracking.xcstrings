{
  "sourceLanguage": "en",
  "strings": {
    "A number of your last location updates is stored on the server (default: last 1000).": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et antal af dine seneste positionsopdateringer gemmes på serveren (standard: de sidste 1000)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Anzahl deiner letzten Standort-Updates wird auf dem Server gespeichert (Standard: die letzten 1000)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number of your last location updates is stored on the server (default: last 1000)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en el servidor un número de tus últimas actualizaciones de ubicación (predeterminado: las últimas 1000)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa viimeisimmistä sijaintipäivityksistä tallennetaan palvelimelle (oletus: viimeiset 1000)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre de tes dernières mises à jour de position est conservé sur le serveur (par défaut : les 1000 dernières)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numero dei tuoi ultimi aggiornamenti di posizione viene salvato sul server (predefinito: gli ultimi 1000)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーにはあなたの最後の位置情報更新が一定数（デフォルト: 最新1000件）保存されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aantal van je laatste locatie-updates wordt op de server opgeslagen (standaard: de laatste 1000)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器会保存你最近的一些位置更新（默认：最近 1000 条）。"
          }
        }
      }
    },
    "activity_type_accuracy_explanation": {
      "comment": "Explanation for location tracking accuracy picker",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrer, hvor aktivt positionsopdateringer anmodes om, mens Miataru er åben i forgrunden. Standard anbefales til daglig brug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie aktiv Standortaktualisierungen angefordert werden, solange Miataru im Vordergrund geöffnet ist. Standard wird für den alltäglichen Einsatz empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how actively location updates are requested while Miataru is open in the foreground. Standard is recommended for everyday use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla con qué intensidad se solicitan actualizaciones de ubicación mientras Miataru está abierto en primer plano. Estándar se recomienda para el uso diario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, kuinka aktiivisesti sijaintipäivityksiä pyydetään, kun Miataru on avoinna etualalla. Vakio on suositeltu päivittäiseen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle l’intensité des demandes de mise à jour de position lorsque Miataru est ouvert au premier plan. Le mode standard est recommandé pour l’usage quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla con quale intensità vengono richiesti gli aggiornamenti di posizione mentre Miataru è aperta in primo piano. Standard è consigliato per l’uso quotidiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru が前面で開いている間に、どの程度積極的に位置情報更新を要求するかを制御します。日常利用には標準が推奨されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoe actief locatie-updates worden aangevraagd terwijl Miataru op de voorgrond is geopend. Standaard wordt aanbevolen voor dagelijks gebruik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制 Miataru 在前台打开时请求位置更新的积极程度。标准适合日常使用。"
          }
        }
      }
    },
