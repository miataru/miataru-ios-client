    "intent_open_miataru_navigation_to_device_description": {
      "comment": "Description for the App Intent that opens Miataru's in-app navigation to a tracked device",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner Miataru-navigation til en enheds senest kendte placering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Miataru-Navigation zum letzten bekannten Standort eines Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Miataru navigation to the last known location of a device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la navegación de Miataru a la última ubicación conocida de un dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Miataru-navigoinnin laitteen viimeisimpään tunnettuun sijaintiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la navigation Miataru vers la dernière position connue d’un appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la navigazione Miataru verso l’ultima posizione conosciuta di un dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの最後に確認された位置へのMiataruナビゲーションを開きます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Miataru-navigatie naar de laatst bekende locatie van een apparaat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Miataru 导航，前往设备最后已知位置。"
          }
        }
      }
    },
