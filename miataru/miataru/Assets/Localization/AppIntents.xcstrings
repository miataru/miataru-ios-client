    "intent_place_error_duplicate_name": {
      "comment": "Error when a saved place name already exists",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der findes allerede et gemt sted med dette navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gespeicherter Ort mit diesem Namen existiert bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved place with this name already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un lugar guardado con este nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä nimellä on jo tallennettu paikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lieu enregistré porte déjà ce nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un luogo salvato con questo nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前の保存済みの場所はすでに存在します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een opgeslagen plaats met deze naam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名的已保存地点。"
          }
        }
      }
    },
    "intent_place_error_invalid_coordinate": {
      "comment": "Error when a saved place coordinate is invalid",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuelle position kan ikke gemmes som et sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Standort kann nicht als Ort gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current location cannot be saved as a place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación actual no se puede guardar como lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyistä sijaintia ei voi tallentaa paikaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position actuelle ne peut pas être enregistrée comme lieu."
          }
