    "intent_list_places_description": {
      "comment": "Description for the App Intent that lists saved places",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Returnerer gemte Miataru-steder uden at vise rå koordinater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt gespeicherte Miataru-Orte zurück, ohne Rohkoordinaten offenzulegen."
          }
