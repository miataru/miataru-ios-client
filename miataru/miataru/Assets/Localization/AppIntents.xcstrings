    "intent_get_distance_to_device_description": {
      "comment": "Description for the App Intent that reports distance to a tracked device",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporterer afstanden fra din aktuelle lokalitet til en sporet enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet die Entfernung von deinem aktuellen Standort zu einem getrackten Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports the distance from your current location to a tracked device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa la distancia desde tu ubicación actual hasta un dispositivo rastreado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoittaa etäisyyden nykyisestä sijainnistasi seurattavaan laitteeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique la distance entre votre position actuelle et un appareil suivi."
          }
        },
        "it": {
