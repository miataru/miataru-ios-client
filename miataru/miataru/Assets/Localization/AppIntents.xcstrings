    "intent_get_device_status_description": {
      "comment": "Description for the App Intent that reports a tracked device's status",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporterer alder og omtrentligt sted for en sporet enheds seneste lokalitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet Alter und ungefähren Ort des neuesten Standorts eines getrackten Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports the age and coarse place of a tracked device's latest location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa la antigüedad y el lugar aproximado de la ubicación más reciente de un dispositivo rastreado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoittaa seurattavan laitteen viimeisimmän sijainnin iän ja karkean paikan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique l’âge et l’emplacement approximatif de la dernière position d’un appareil suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica età e posizione approssimativa dell’ultima posizione di un dispositivo tracciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡対象デバイスの最新位置の経過時間とおおよその場所を報告します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldt de leeftijd en globale plaats van de nieuwste locatie van een gevolgd apparaat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告已跟踪设备最新位置的时间和大致地点。"
          }
        }
      }
    },
    "intent_get_device_status_dialog_format": {
      "comment": "Dialog for tracked device status. Arguments: display name, age text, coarse place.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev sidst set for %@ siden i nærheden af %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde zuletzt vor %@ in der Nähe von %@ gesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was last seen %@ ago near %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se vio por última vez hace %@ cerca de %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nähtiin viimeksi %@ sitten lähellä kohdetta %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été vu pour la dernière fois il y a %@ près de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato visto l’ultima volta %@ fa vicino a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%@前に%@付近で最後に確認されました。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@ geleden voor het laatst gezien bij %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上次出现在 %@ 前，位于 %@ 附近。"
          }
        }
      }
    },
