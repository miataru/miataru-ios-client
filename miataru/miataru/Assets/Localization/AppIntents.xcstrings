    "intent_clear_miataru_events_description": {
      "comment": "Description for the App Intent that clears Miataru automation events",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydder Miataru-automationshændelser, eventuelt kun hændelser ældre end en dato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Miataru-Automationsereignisse, optional nur Ereignisse vor einem Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears Miataru automation events, optionally only events older than a date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra eventos de automatización de Miataru, opcionalmente solo los anteriores a una fecha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjentää Miataru-automaatiotapahtumat, haluttaessa vain tiettyä päivää vanhemmat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les événements d’automatisation Miataru, éventuellement seulement ceux antérieurs à une date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella eventi di automazione Miataru, eventualmente solo quelli precedenti a una data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru自動化イベントを消去します。必要に応じて指定日より古いイベントだけを消去します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist Miataru-automatiseringsgebeurtenissen, eventueel alleen gebeurtenissen ouder dan een datum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 Miataru 自动化事件，也可仅清除早于某日期的事件。"
          }
        }
      }
    },
