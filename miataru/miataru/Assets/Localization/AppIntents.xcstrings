      "comment": "Error shown when frequent background tracking is started without Always location authorization",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyppig baggrundssporing kræver altid adgang til placering. Åbn Miataru, og tillad Altid-adgang, før du starter den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufige Hintergrundverfolgung benötigt Immer-Zugriff auf den Standort. Öffne Miataru und erlaube Immer-Zugriff, bevor du sie startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequent background tracking needs Always location access. Open Miataru and allow Always access before starting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento frecuente en segundo plano necesita acceso Siempre a la ubicación. Abre Miataru y permite el acceso Siempre antes de iniciarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiheä taustaseuranta tarvitsee aina sallitun sijaintioikeuden. Avaa Miataru ja salli aina käyttö ennen sen käynnistämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi fréquent en arrière-plan nécessite l’accès permanent à la position. Ouvrez Miataru et autorisez l’accès permanent avant de le démarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tracciamento frequente in background richiede l’accesso Sempre alla posizione. Apri Miataru e consenti l’accesso Sempre prima di avviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻繁なバックグラウンド追跡には、位置情報の「常に許可」が必要です。開始する前にMiataruを開き、「常に許可」を有効にしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequente achtergrondtracking heeft Altijd-toegang tot locatie nodig. Open Miataru en sta Altijd-toegang toe voordat je dit start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频繁后台跟踪需要“始终”位置访问权限。请先打开 Miataru 并允许“始终”访问，然后再启动。"
          }
        }
      }
    },
    "intent_frequent_tracking_error_device_key_blocked": {
      "comment": "Error shown when frequent tracking is started while DeviceKey authentication blocks tracking",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru stoppede sporingen, fordi DeviceKey-godkendelsen mislykkedes. Åbn Miataru for at opdatere din DeviceKey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru hat die Verfolgung gestoppt, weil die DeviceKey-Authentifizierung fehlgeschlagen ist. Öffne Miataru, um deinen DeviceKey zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru stopped tracking because DeviceKey authentication failed. Open Miataru to update your DeviceKey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru detuvo el seguimiento porque falló la autenticación de DeviceKey. Abre Miataru para actualizar tu DeviceKey."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru lopetti seurannan, koska DeviceKey-todennus epäonnistui. Avaa Miataru päivittääksesi DeviceKey-avaimesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru a arrêté le suivi, car l’authentification DeviceKey a échoué. Ouvrez Miataru pour mettre à jour votre DeviceKey."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ha interrotto il tracciamento perché l’autenticazione DeviceKey non è riuscita. Apri Miataru per aggiornare la tua DeviceKey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey認証に失敗したため、Miataruは追跡を停止しました。Miataruを開いてDeviceKeyを更新してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru heeft tracking gestopt omdat DeviceKey-verificatie is mislukt. Open Miataru om je DeviceKey bij te werken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 DeviceKey 认证失败，Miataru 已停止跟踪。请打开 Miataru 更新你的 DeviceKey。"
          }
        }
      }
    },
    "intent_frequent_tracking_error_tracking_disabled": {
      "comment": "Error shown when frequent tracking is started while normal location tracking is disabled",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokationssporing er slået fra. Slå lokationssporing til i Miataru, før du starter hyppig sporing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortverfolgung ist ausgeschaltet. Aktiviere die Standortverfolgung in Miataru, bevor du häufige Verfolgung startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location tracking is off. Turn on location tracking in Miataru before starting frequent tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento de ubicación está desactivado. Activa el seguimiento de ubicación en Miataru antes de iniciar el seguimiento frecuente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijainnin seuranta on pois päältä. Ota sijainnin seuranta käyttöön Miatarussa ennen tiheän seurannan käynnistämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi de position est désactivé. Activez le suivi de position dans Miataru avant de démarrer le suivi fréquent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tracciamento della posizione è disattivato. Attivalo in Miataru prima di avviare il tracciamento frequente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の追跡がオフです。頻繁な追跡を開始する前に、Miataruで位置情報の追跡をオンにしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietracking staat uit. Schakel locatietracking in Miataru in voordat je frequente tracking start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置跟踪已关闭。请先在 Miataru 中打开位置跟踪，然后再启动频繁跟踪。"
          }
        }
      }
    },
