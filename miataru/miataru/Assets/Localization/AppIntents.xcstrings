    "intent_stop_frequent_tracking_description": {
      "comment": "Description for the App Intent that stops manual frequent background tracking",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper Miatarus hyppigere baggrundssporing og lader standardsporing være uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt Miatarus häufigere Hintergrundverfolgung und lässt die Standardverfolgung unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops Miataru's more frequent background tracking and keeps standard tracking unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el seguimiento en segundo plano más frecuente de Miataru y mantiene sin cambios el seguimiento estándar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäyttää Miatarun tiheämmän taustaseurannan ja pitää tavallisen seurannan ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le suivi plus fréquent en arrière-plan de Miataru et garde le suivi standard inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe il tracciamento in background più frequente di Miataru e lascia invariato il tracciamento standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruのより頻繁なバックグラウンド追跡を停止し、標準の追跡は変更しません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt Miataru's frequentere achtergrondtracking en laat standaardtracking ongewijzigd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Miataru 更频繁的后台跟踪，并保持标准跟踪不变。"
          }
        }
      }
    },
