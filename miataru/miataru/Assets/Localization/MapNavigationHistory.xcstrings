    "route_generation_failed": {
      "comment": "Route calculation failed. Please try again.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke generere en rute mellem placeringerne. Prøv at ændre transporttilstand i indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
