          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートを交換して、デバイスからあなたへのナビゲーション、またはあなたからデバイスへのナビゲーションを表示します。"
          }
        },
        "nl": {
