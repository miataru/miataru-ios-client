    "reverse_navigation_direction_hint": {
      "comment": "Swaps the route to show navigation from the device to you, or from you to the device.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytter ruten for at vise navigation fra enheden til dig eller fra dig til enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauscht die Route, um die Navigation vom Gerät zu dir oder von dir zum Gerät anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps the route to show navigation from the device to you, or from you to the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invierte la ruta para mostrar la navegación del dispositivo hacia ti o de ti hacia el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
