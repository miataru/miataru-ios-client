          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de DeviceKey in die je voor dit apparaat wilt gebruiken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
