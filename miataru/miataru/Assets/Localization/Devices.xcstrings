          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegangscontrole inschakelen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用访问控制"
          }
        }
      }
    },
    "allowed_device_list_enabled_explanation": {
      "comment": "Explanation text when feature is enabled",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til aktuel position og historik kan administreres for hver kendt enhed på skærmen Enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf aktuellen Standort und Standortverlauf kann für jedes bekannte Gerät im Bildschirm „Geräte“ verwaltet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current-location and history access can be managed for each known device in the Devices screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación actual y al historial puede gestionarse para cada dispositivo conocido en la pantalla Dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyisen sijainnin ja historian käyttöoikeuksia voidaan hallita jokaiselle tunnetulle laitteelle Laitteet-näytössä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position actuelle et à l’historique peut être géré pour chaque appareil connu dans l’écran Appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alla posizione attuale e alla cronologia può essere gestito per ogni dispositivo conosciuto nella schermata Dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地と履歴へのアクセスは、デバイス画面で既知の各デバイスごとに管理できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot huidige locatie en geschiedenis kan per bekend apparaat worden beheerd in het scherm Apparaten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在设备页面为每个已知设备管理当前位置和历史记录的访问权限。"
          }
        }
      }
    },
