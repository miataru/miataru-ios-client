    "known_visitor_alerts_explanation": {
      "comment": "Explanation for known-device visitor history access notifications",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender en notifikation, når denne enhed for nylig har forespurgt din position under tjek af visitorhistorikken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine Mitteilung, wenn dieses Gerät deine Position kürzlich während der Besucherhistorie-Prüfung abgefragt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a notification when this device recently checked your position during visitor-history checks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una notificación cuando este dispositivo haya consultado recientemente tu posición durante las comprobaciones del historial de visitantes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää ilmoituksen, kun tämä laite on äskettäin tarkistanut sijaintisi vierailijahistorian tarkistusten aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une notification lorsque cet appareil a récemment consulté votre position pendant les contrôles de l’historique des visiteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia una notifica quando questo dispositivo ha controllato di recente la tua posizione durante i controlli della cronologia visitatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問者履歴の確認中に、このデバイスが最近あなたの位置情報を確認した場合に通知します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt een melding wanneer dit apparaat onlangs je positie heeft bekeken tijdens controles van de bezoekersgeschiedenis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此设备在访客历史检查期间最近查询了你的位置时发送通知。"
          }
        }
      }
    },
    "known_visitor_alerts_permission_denied_message": {
      "comment": "Permission denied explanation for known-device visitor notification opt-in",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået fra. Tillad notifikationer i Indstillinger for at bruge denne enhedsadvarsel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Erlaube Mitteilungen in den Einstellungen, um diese Gerätebenachrichtigung zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled. Allow notifications in Settings to use this device alert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Permítelas en Ajustes para usar esta alerta del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat pois käytöstä. Salli ilmoitukset Asetuksissa, jotta voit käyttää tätä laitehälytystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Autorisez-les dans Réglages pour utiliser cette alerte d’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Consenti le notifiche in Impostazioni per usare questo avviso del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が無効です。このデバイス通知を使うには、設定で通知を許可してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn uitgeschakeld. Sta meldingen toe in Instellingen om deze apparaatmelding te gebruiken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。请在“设置”中允许通知，以使用此设备提醒。"
          }
        }
      }
    },
