    "allowed_device_list_current_location_access": {
      "comment": "Toggle label for current location access",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til nuværende position"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf aktuelle Position"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Location Access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a ubicación actual"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyisen sijainnin käyttöoikeus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès à la position actuelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla posizione corrente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地へのアクセス"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot huidige locatie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前位置访问"
          }
        }
      }
    },
    "allowed_device_list_current_location_access_description": {
      "comment": "Description for current location access toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad denne enhed at få adgang til din nuværende position"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Gerät den Zugriff auf Ihre aktuelle Position erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this device to access your current location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que este dispositivo acceda a tu ubicación actual"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli tämän laitteen käyttää nykyistä sijaintiasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser cet appareil à accéder à votre position actuelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a questo dispositivo di accedere alla tua posizione corrente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスが現在地にアクセスすることを許可"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta dit apparaat toe toegang te krijgen tot uw huidige locatie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此设备访问您的当前位置"
          }
        }
      }
    },
    "allowed_device_list_devicekey_hint": {
      "comment": "Accessibility hint for DeviceKey setup button",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner DeviceKey-opsætningsark"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das DeviceKey-Einrichtungsblatt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens DeviceKey setup sheet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la hoja de configuración de DeviceKey"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa DeviceKey-asetusarkin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la feuille de configuration DeviceKey"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il foglio di configurazione DeviceKey"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey設定シートを開く"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent het DeviceKey-instellingenblad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设备密钥设置表"
          }
        }
      }
    },
    "allowed_device_list_disabled_explanation": {
      "comment": "Explanation text when feature is disabled",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskontrol begrænser, hvilke enheder der kan læse aktuelle positions- og historikdata. En DeviceKey er påkrævet, og funktionen forbliver aktiveret efter aktivering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zugriffskontrolle begrenzt, welche Geräte aktuelle Standort- und Verlaufsdaten lesen dürfen. Ein DeviceKey ist erforderlich, und die Funktion bleibt nach der Aktivierung eingeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access control limits which devices can read current-location and history data. A DeviceKey is required, and the feature stays enabled once activated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control de acceso limita qué dispositivos pueden leer los datos de ubicación actual y del historial. Se requiere una DeviceKey y la función permanece activada una vez habilitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöoikeuksien hallinta rajoittaa, mitkä laitteet voivat lukea nykyisen sijainnin ja historiatiedot. DeviceKey vaaditaan, ja toiminto pysyy käytössä aktivoinnin jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle d’accès limite les appareils pouvant lire la position actuelle et l’historique. Une DeviceKey est requise et la fonction reste activée après son activation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo accessi limita quali dispositivi possono leggere la posizione attuale e la cronologia. È richiesta una DeviceKey e la funzione resta attiva dopo l’attivazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス制御により、現在地と履歴データを読めるデバイスが制限されます。DeviceKey が必要で、一度有効にすると機能は有効のままです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegangscontrole beperkt welke apparaten huidige locatie- en geschiedenisgegevens kunnen lezen. Een DeviceKey is vereist en de functie blijft ingeschakeld nadat deze is geactiveerd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问控制可限制哪些设备能够读取当前位置和历史数据。此功能需要 DeviceKey，并且启用后会保持开启。"
          }
        }
      }
    },
    "allowed_device_list_enable_button": {
      "comment": "Button to enable the allowed device list feature",
      "localizations": {
