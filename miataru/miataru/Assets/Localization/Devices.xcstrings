    "device_key_auth_mismatch_message": {
      "comment": "Message when stored DeviceKey does not match server",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte DeviceKey matcher ikke serveren. Indstil eller gendan din DeviceKey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte DeviceKey stimmt nicht mit dem Server überein. Bitte DeviceKey setzen oder wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored DeviceKey does not match the server. Please set or restore your DeviceKey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El DeviceKey almacenado no coincide con el servidor. Configura o restaura tu DeviceKey."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu DeviceKey ei vastaa palvelinta. Aseta tai palauta DeviceKey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le DeviceKey enregistré ne correspond pas au serveur. Définis ou restaure ton DeviceKey."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il DeviceKey salvato non corrisponde al server. Imposta o ripristina il tuo DeviceKey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された DeviceKey がサーバーと一致しません。DeviceKey を設定または復元してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen DeviceKey komt niet overeen met de server. Stel je DeviceKey in of herstel deze."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 DeviceKey 与服务器不匹配。请设置或恢复你的 DeviceKey。"
          }
        }
      }
    },
    "device_key_auth_required_message": {
