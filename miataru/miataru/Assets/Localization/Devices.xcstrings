    "device_key_emergency_server_side_hint": {
      "comment": "Hint explaining that a newly created server identity might still exist",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal tilbagerulning er gennemført. En nyoprettet DeviceID kan stadig eksistere på serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Rollback wurde durchgeführt. Eine neu erzeugte DeviceID kann serverseitig trotzdem bereits existieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local rollback completed. A newly created DeviceID may still exist on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reversión local se completó. Una DeviceID recién creada puede seguir existiendo en el servidor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen palautus onnistui. Uusi DeviceID voi silti olla jo palvelimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rollback local a été effectué. Un DeviceID nouvellement créé peut encore exister côté serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollback locale completato. Un DeviceID appena creato potrebbe comunque esistere sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのロールバックは完了しました。新しく作成された DeviceID がサーバー側に残っている可能性があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale rollback voltooid. Een nieuw aangemaakte DeviceID kan nog op de server bestaan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地回滚已完成。新创建的 DeviceID 仍可能存在于服务器上。"
          }
        }
      }
    },
