            "value": "Ota käyttöoikeuksien hallinta käyttöön"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le contrôle d'accès"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita controllo accesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
