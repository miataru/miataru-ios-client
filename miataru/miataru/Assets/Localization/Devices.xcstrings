    "unknown_visitor_alerts_permission_denied_message": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået fra for Miataru. Aktivér notifikationer i iOS-indstillinger for at bruge funktionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Miataru deaktiviert. Aktiviere Mitteilungen in den iOS-Einstellungen, um diese Funktion zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled for Miataru. Enable notifications in iOS Settings to use this feature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Miataru. Activa las notificaciones en los ajustes de iOS para usar esta función."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset on poistettu käytöstä Miatarulle. Ota ilmoitukset käyttöön iOS-asetuksissa, jotta voit käyttää tätä toimintoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Miataru. Activez-les dans les réglages iOS pour utiliser cette fonctionnalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Miataru. Abilita le notifiche nelle impostazioni iOS per usare questa funzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru の通知が無効です。この機能を使うには iOS の設定で通知を有効にしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn voor Miataru uitgeschakeld. Schakel meldingen in via iOS-instellingen om deze functie te gebruiken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 的通知已关闭。请在 iOS 设置中开启通知以使用此功能。"
