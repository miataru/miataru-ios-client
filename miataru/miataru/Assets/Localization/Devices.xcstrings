    "device_key_custom_emergency_confirm_message": {
      "comment": "Confirmation message for emergency identity reset",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette opretter en ny DeviceID og DeviceKey for denne app-installation. Kendte enheder med adgangskontrol skal godkende denne enhed igen. Fortsæt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird für diese App-Installation eine neue DeviceID und ein neuer DeviceKey erzeugt. Bereits bekannte Geräte mit Zugriffskontrolle müssen dieses Gerät erneut authentifizieren. Fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This creates a new DeviceID and DeviceKey for this app install. Known devices using access control must authenticate this device again. Continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto crea una nueva DeviceID y un nuevo DeviceKey para esta instalación. Los dispositivos conocidos que usan control de acceso deberán autenticar este dispositivo de nuevo. ¿Continuar?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä luo uuden DeviceID:n ja DeviceKeyn tälle asennukselle. Tunnettujen laitteiden, jotka käyttävät pääsynhallintaa, täytyy todentaa tämä laite uudelleen. Jatketaanko?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela crée un nouveau DeviceID et un nouveau DeviceKey pour cette installation. Les appareils connus qui utilisent le contrôle d’accès devront authentifier à nouveau cet appareil. Continuer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo crea un nuovo DeviceID e un nuovo DeviceKey per questa installazione. I dispositivi noti che usano il controllo accessi dovranno autenticare di nuovo questo dispositivo. Continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作で、このアプリのインストールに新しい DeviceID と DeviceKey が作成されます。アクセス制御を使用している既知のデバイスでは、このデバイスの再認証が必要になります。続行しますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit maakt een nieuwe DeviceID en DeviceKey voor deze app-installatie. Bekende apparaten met toegangscontrole moeten dit apparaat opnieuw authenticeren. Doorgaan?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将为当前安装创建新的 DeviceID 和 DeviceKey。已知设备中使用访问控制的设备需要重新认证此设备。要继续吗？"
          }
        }
      }
    },
    "device_key_custom_emergency_confirm_title": {
      "comment": "Confirmation title for emergency identity reset",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret ny identitet?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Geräte-Identität erzeugen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create New Device Identity?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Crear nueva identidad del dispositivo?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luodaanko uusi laite-identiteetti?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une nouvelle identité d’appareil ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creare una nuova identità del dispositivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいデバイス識別情報を作成しますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe apparaatidentiteit maken?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建新的设备身份？"
          }
        }
      }
    },
    "device_key_custom_emergency_explanation": {
      "comment": "Warning text for emergency identity reset in custom key sheet",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din DeviceKey ikke kan gendannes, kan du oprette en ny DeviceID med en ny DeviceKey. Vigtigt: Kendte enheder, der bruger adgangskontrol, skal godkende denne enhed igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein DeviceKey nicht wiederhergestellt werden kann, kannst du eine neue DeviceID mit neuem DeviceKey erzeugen. Wichtig: Alle bekannten Geräte mit Zugriffskontrolle müssen dieses Gerät danach erneut authentifizieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your DeviceKey cannot be restored, you can create a new DeviceID with a new DeviceKey. Important: all known devices using access control must authenticate this device again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu DeviceKey no puede restaurarse, puedes crear una nueva DeviceID con un nuevo DeviceKey. Importante: todos los dispositivos conocidos que usen control de acceso deberán autenticar este dispositivo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos DeviceKeytä ei voi palauttaa, voit luoda uuden DeviceID:n uudella DeviceKeyllä. Tärkeää: kaikki tunnetut laitteet, jotka käyttävät pääsynhallintaa, joutuvat todentamaan tämän laitteen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ton DeviceKey ne peut pas être restauré, tu peux créer un nouveau DeviceID avec un nouveau DeviceKey. Important : tous les appareils connus utilisant le contrôle d’accès devront authentifier à nouveau cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo DeviceKey non può essere ripristinato, puoi creare una nuova DeviceID con un nuovo DeviceKey. Importante: tutti i dispositivi noti che usano il controllo accessi dovranno autenticare nuovamente questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey を復元できない場合は、新しい DeviceID と新しい DeviceKey を作成できます。重要: アクセス制御を使用している既知のデバイスは、このデバイスを再認証する必要があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je DeviceKey niet kan worden hersteld, kun je een nieuwe DeviceID met een nieuwe DeviceKey aanmaken. Belangrijk: alle bekende apparaten die toegangscontrole gebruiken, moeten dit apparaat opnieuw authenticeren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果无法恢复你的 DeviceKey，你可以创建新的 DeviceID 和新的 DeviceKey。重要：所有使用访问控制的已知设备都需要重新认证此设备。"
          }
        }
      }
    },
    "device_key_custom_message": {
      "comment": "Message for custom device key entry",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast den DeviceKey, du vil bruge til denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den DeviceKey ein, den du für dieses Gerät verwenden möchtest."
          }
