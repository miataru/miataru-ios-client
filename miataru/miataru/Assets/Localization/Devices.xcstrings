    "device_key_long_press_admin_hint": {
      "comment": "Hint explaining that a long press on the keycard reveals administrative options",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold på nøglekortet for at låse de administrative muligheder op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke lange auf die Schlüsselkarte, um die administrativen Optionen freizuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long press the Keycard to unlock the administrative options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la tarjeta de clave para desbloquear las opciones administrativas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina avainkorttia pitkään avataksesi hallinnolliset asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie longuement sur la carte-clé pour déverrouiller les options administratives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la scheda chiave per sbloccare le opzioni amministrative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者向けオプションを表示するには、キーカードを長押ししてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de sleutelkaart ingedrukt om de beheerdersopties te ontgrendelen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按密钥卡以解锁管理选项。"
          }
        }
      }
    },
    "device_key_mismatch_explanation": {
      "comment": "Explanation shown when DeviceKey does not match server",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne DeviceKey accepteres ikke af serveren. Gendan den korrekte DeviceKey for at genoptage opdateringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser DeviceKey wird vom Server nicht akzeptiert. Stelle den korrekten DeviceKey wieder her, um Updates fortzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This DeviceKey is not accepted by the server. Restore the correct DeviceKey to resume updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este DeviceKey no es aceptado por el servidor. Restaura el DeviceKey correcto para reanudar las actualizaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei hyväksy tätä DeviceKeytä. Palauta oikea DeviceKey, jotta päivitykset voivat jatkua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce DeviceKey n’est pas accepté par le serveur. Restaure le DeviceKey correct pour reprendre les mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo DeviceKey non è accettato dal server. Ripristina il DeviceKey corretto per riprendere gli aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この DeviceKey はサーバーに受け付けられていません。正しい DeviceKey を復元して更新を再開してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze DeviceKey wordt niet geaccepteerd door de server. Herstel de juiste DeviceKey om updates te hervatten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不接受此 DeviceKey。请恢复正确的 DeviceKey 以继续更新。"
          }
        }
      }
    },
