          "stringUnit": {
            "state": "translated",
            "value": "È richiesta l’autenticazione DeviceKey. Imposta o ripristina il tuo DeviceKey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey の認証が必要です。DeviceKey を設定または復元してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey-authenticatie is vereist. Stel je DeviceKey in of herstel deze."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 DeviceKey 认证。请设置或恢复你的 DeviceKey。"
          }
        }
      }
    },
    "device_key_auth_runtime_error_message": {
      "comment": "Runtime auth error when stored DeviceKey is missing or invalid",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey-fejl: Den aktuelt gemte DeviceKey mangler eller accepteres ikke af serveren. Indstil eller gendan din DeviceKey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey-Fehler: Der aktuell gespeicherte DeviceKey fehlt oder wird vom Server nicht akzeptiert. Bitte DeviceKey setzen oder wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey error: The currently stored DeviceKey is missing or not accepted by the server. Please set or restore your DeviceKey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de DeviceKey: el DeviceKey almacenado actualmente falta o no es aceptado por el servidor. Configura o restaura tu DeviceKey."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey-virhe: nykyinen tallennettu DeviceKey puuttuu tai palvelin ei hyväksy sitä. Aseta tai palauta DeviceKey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur DeviceKey : le DeviceKey actuellement enregistré est manquant ou non accepté par le serveur. Définis ou restaure ton DeviceKey."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore DeviceKey: il DeviceKey attualmente salvato manca o non è accettato dal server. Imposta o ripristina il tuo DeviceKey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey エラー: 現在保存されている DeviceKey がないか、サーバーに受け付けられていません。DeviceKey を設定または復元してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey-fout: de momenteel opgeslagen DeviceKey ontbreekt of wordt niet geaccepteerd door de server. Stel je DeviceKey in of herstel deze."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeviceKey 错误：当前保存的 DeviceKey 缺失或不被服务器接受。请设置或恢复你的 DeviceKey。"
          }
        }
      }
    },
