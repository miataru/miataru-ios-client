{
  "sourceLanguage": "en",
  "strings": {
    "adddevice_duplicate_device_already_exists_message": {
      "comment": "Alert text shown when user tries to add a duplicate device.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der findes allerede en enhed med dette DeviceID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gerät mit dieser Geräte-ID existiert bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device with this DeviceID already exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un dispositivo con este ID."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä DeviceID:llä on jo laite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil avec cet identifiant existe déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste già un dispositivo con questo DeviceID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスIDを持つデバイスは既に存在します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een apparaat met dit DeviceID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在具有此设备 ID 的设备。"
          }
        }
      }
    },
    "adddevice_duplicate_device_id_case_insensitive_message": {
      "comment": "Alert text shown when a device ID matches an existing device ignoring letter case.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed er allerede kendt som %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist bereits als %@ bekannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is already known as %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ya se conoce como %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite tunnetaan jo nimellä %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est déjà connu sous %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è già noto come %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはすでに %@ として登録されています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat is al bekend als %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已作为 %@ 存在。"
          }
        }
      }
    },
