  "strings": {
    "Check a device status in ${applicationName}": {
      "localizations": {
        "da": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Tjek en enheds status i ${applicationName}",
              "Hvornår blev en enheds position sidst opdateret i ${applicationName}"
            ]
          }
        },
        "de": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Gerätestatus in ${applicationName} prüfen",
              "Wann wurde der Standort eines Geräts in ${applicationName} zuletzt aktualisiert"
            ]
          }
        },
        "en": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Check a device status in ${applicationName}",
              "When was a device's location last updated in ${applicationName}"
            ]
          }
        },
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
