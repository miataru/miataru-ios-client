    "Easily share your device ID or add others by scanning QR-Codes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del nemt din enheds-ID eller tilføj andre ved at scanne QR-koder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deine Geräte‑ID einfach oder füge andere hinzu, indem du QR‑Codes scannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily share your device ID or add others by scanning QR-Codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte fácilmente tu ID de dispositivo o añade otros escaneando códigos QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez facilement votre identifiant d’appareil ou ajoutez-en d’autres en scannant des codes QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードをスキャンしてデバイスIDを簡単に共有したり、他のユーザーを追加したりできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel eenvoudig je apparaat-ID of voeg anderen toe door QR-codes te scannen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过扫描二维码轻松分享你的设备 ID 或添加其他设备。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa laitetunnus helposti tai lisää muita skannaamalla QR-koodeja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi facilmente il tuo ID dispositivo o aggiungi altri scansionando codici QR."
          }
        }
      }
    },
