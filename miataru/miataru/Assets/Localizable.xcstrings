    "activity_type_accuracy_explanation" : {
      "comment" : "Explanation for location tracking accuracy picker",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan vælge, hvor ofte din placering opdateres, når appen er i forgrunden. Standard anbefales til de fleste og sparer batteri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst die Aktualisierungsfrequenz deines Standorts im Hintergrund auswählen. Standard wird den meisten Nutzern empfohlen und spart Akku."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can choose the update frequency of your location when the app is used in the foreground. Standard is recommended for most users and saves battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes elegir la frecuencia de actualización de tu ubicación cuando la app está en primer plano. Se recomienda Estándar para la mayoría de usuarios y ahorra batería."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit valita, kuinka usein sijaintia päivitetään etualalla. Suositus on Standard, joka säästää akkua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux choisir la fréquence de mise à jour de ta position lorsque l’app est au premier plan. Standard est recommandé pour la plupart des utilisateurs et économise la batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi scegliere la frequenza di aggiornamento della posizione quando l'app è in primo piano. Standard è consigliato e risparmia batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがバックグラウンドにある際の位置情報更新頻度を選択できます。標準がほとんどのユーザーに推奨され、バッテリーを節約します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt kiezen hoe vaak je locatie wordt bijgewerkt als de app op de voorgrond staat. Standaard wordt aanbevolen voor de meeste gebruikers en bespaart batterij."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以选择在前台使用时的位置更新频率。推荐标准模式，适合多数用户并节省电量。"
          }
        }
      }
    },
