          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図の基本スタイルを標準、ハイブリッド、衛星表示の間で切り替えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
