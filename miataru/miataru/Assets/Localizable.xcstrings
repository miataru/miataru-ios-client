    "device_key_custom_emergency_explanation" : {
      "comment" : "Warning text for emergency identity reset in custom key sheet",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis din DeviceKey ikke kan gendannes, kan du oprette en ny DeviceID med en ny DeviceKey. Vigtigt: Kendte enheder, der bruger adgangskontrol, skal godkende denne enhed igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dein DeviceKey nicht wiederhergestellt werden kann, kannst du eine neue DeviceID mit neuem DeviceKey erzeugen. Wichtig: Alle bekannten Geräte mit Zugriffskontrolle müssen dieses Gerät danach erneut authentifizieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your DeviceKey cannot be restored, you can create a new DeviceID with a new DeviceKey. Important: all known devices using access control must authenticate this device again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu DeviceKey no puede restaurarse, puedes crear una nueva DeviceID con un nuevo DeviceKey. Importante: todos los dispositivos conocidos que usen control de acceso deberán autenticar este dispositivo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos DeviceKeytä ei voi palauttaa, voit luoda uuden DeviceID:n uudella DeviceKeyllä. Tärkeää: kaikki tunnetut laitteet, jotka käyttävät pääsynhallintaa, joutuvat todentamaan tämän laitteen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ton DeviceKey ne peut pas être restauré, tu peux créer un nouveau DeviceID avec un nouveau DeviceKey. Important : tous les appareils connus utilisant le contrôle d’accès devront authentifier à nouveau cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il tuo DeviceKey non può essere ripristinato, puoi creare una nuova DeviceID con un nuovo DeviceKey. Importante: tutti i dispositivi noti che usano il controllo accessi dovranno autenticare nuovamente questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeviceKey を復元できない場合は、新しい DeviceID と新しい DeviceKey を作成できます。重要: アクセス制御を使用している既知のデバイスは、このデバイスを再認証する必要があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je DeviceKey niet kan worden hersteld, kun je een nieuwe DeviceID met een nieuwe DeviceKey aanmaken. Belangrijk: alle bekende apparaten die toegangscontrole gebruiken, moeten dit apparaat opnieuw authenticeren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
