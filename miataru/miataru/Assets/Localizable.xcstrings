    "allowed_device_list_disabled_explanation" : {
      "comment" : "Explanation text when feature is disabled",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver adgangskontrol for at administrere, hvilke enheder der kan få adgang til dine positionsdata. Kræver en DeviceKey og kan ikke deaktiveres, når den er aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie die Zugriffskontrolle, um zu verwalten, welche Geräte auf Ihre Positionsdaten zugreifen können. Erfordert einen DeviceKey und kann nach der Aktivierung nicht deaktiviert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable access control to manage which devices can access your location data. Requires a DeviceKey and cannot be disabled once enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilita el control de acceso para gestionar qué dispositivos pueden acceder a tus datos de ubicación. Requiere un DeviceKey y no se puede desactivar una vez habilitado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöoikeuksien hallinta käyttöön hallitsemaan, mitkä laitteet voivat käyttää sijaintitietojasi. Vaatii DeviceKeyn ja sitä ei voi poistaa käytöstä, kun se on otettu käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le contrôle d'accès pour gérer quels appareils peuvent accéder à vos données de localisation. Nécessite un DeviceKey et ne peut pas être désactivé une fois activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita il controllo di accesso per gestire quali dispositivi possono accedere ai tuoi dati di posizione. Richiede un DeviceKey e non può essere disabilitato una volta abilitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス制御を有効にして、どのデバイスが位置情報にアクセスできるかを管理します。DeviceKeyが必要で、一度有効にすると無効にできません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel toegangscontrole in om te beheren welke apparaten toegang hebben tot uw locatiegegevens. Vereist een DeviceKey en kan niet worden uitgeschakeld zodra het is ingeschakeld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用访问控制以管理哪些设备可以访问您的位置数据。需要设备密钥，一旦启用后无法禁用。"
          }
        }
      }
    },
