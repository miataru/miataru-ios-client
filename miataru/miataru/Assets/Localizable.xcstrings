            "value": "Puedes cambiar tus ajustes o permisos en cualquier momento en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier vos réglages ou autorisations à tout moment dans l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内でいつでも設定や権限を変更できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt je instellingen of machtigingen altijd in de app aanpassen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在应用内更改设置或权限。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit muuttaa asetuksia tai lupia milloin tahansa sovelluksessa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificare impostazioni o permessi in qualsiasi momento nell'app."
          }
        }
      }
    },
    "You can choose how your location data is stored on the Miataru server.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan vælge, hvordan dine positionsdata gemmes på Miataru-serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst wählen, wie deine Standortdaten auf dem Miataru-Server gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose how your location data is stored on the Miataru server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir cómo se almacenan tus datos de ubicación en el servidor Miataru."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez choisir comment vos données de localisation sont stockées sur le serveur Miataru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruサーバーで位置情報がどのように保存されるかを選択できます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt kiezen hoe je locatiedata op de Miataru-server wordt opgeslagen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以选择 Miataru 服务器保存你位置信息的方式。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit valita, miten sijaintitietosi tallennetaan Miataru-palvelimelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scegliere come vengono archiviate le tue posizioni sul server Miataru."
          }
        }
      }
    },
    "Your data is only sent when you specifically activate it": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data sendes kun, når du aktivt slår det til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden nur gesendet, wenn du sie gezielt aktivierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is only sent when you specifically activate it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos solo se envían cuando los activas explícitamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données ne sont envoyées que lorsque vous les activez explicitement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データは、あなたが明示的に有効にしたときにのみ送信されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je data wordt alleen verzonden wanneer je dit zelf activeert"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主动启用时，数据才会发送"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietosi lähetetään vain, kun aktivoit sen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati vengono inviati solo quando li attivi esplicitamente"
          }
        }
      }
    },
    "Your data stays on the server you choose for the time you choose": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data forbliver på den server, du vælger, i den periode, du vælger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten bleiben so lange auf dem Server, wie du es festlegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on the server you choose for the time you choose"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos permanecen en el servidor que elijas durante el tiempo que decidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent sur le serveur que vous choisissez pendant la durée que vous choisissez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データは、選択したサーバーに選択した期間だけ保存されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je data blijft op de server die je kiest, zolang als je kiest"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据只会在你选择的服务器上保存指定时间"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietosi pysyvät valitsemallasi palvelimella valitsemasi ajan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano sul server scelto per il tempo che decidi"
          }
        }
      }
    },
    "Your location data is stored on a server you trust. You can use the default Miataru server, or enter your own server address.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine positionsdata gemmes på en server, du har tillid til. Du kan bruge Miatarus standardserver eller indtaste din egen serveradresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Standortdaten werden auf einem Server gespeichert, dem du vertraust. Du kannst den Standard-Miataru-Server verwenden oder deine eigene Serveradresse eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location data is stored on a server you trust. You can use the default Miataru server, or enter your own server address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos de ubicación se almacenan en un servidor de confianza. Puedes usar el servidor predeterminado de Miataru o introducir la dirección de tu propio servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données de localisation sont stockées sur un serveur de confiance. Vous pouvez utiliser le serveur Miataru par défaut ou saisir l’adresse de votre propre serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの位置情報は、信頼できるサーバーに保存されます。デフォルトのMiataruサーバーを使用するか、自分のサーバーアドレスを入力してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatiedata wordt opgeslagen op een server die je vertrouwt. Je kunt de standaard Miataru-server gebruiken of je eigen serveradres invoeren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的位置信息存储在你信任的服务器上。可以使用默认的 Miataru 服务器，或输入自有服务器地址。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintitietosi tallennetaan luotettavalle palvelimelle. Voit käyttää oletus-Miataru-palvelinta tai syöttää oman palvelimen osoitteen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati di posizione sono archiviati su un server di cui ti fidi. Puoi usare il server predefinito di Miataru o inserire l'indirizzo del tuo server."
          }
        }
      }
    },
