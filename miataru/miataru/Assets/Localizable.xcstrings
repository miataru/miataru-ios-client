    "background_location_distance_filter_100m_explanation" : {
      "comment" : "Explanation for 100 m frequent background movement threshold",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard. Accepterer hyppigere baggrundsopdateringer efter ca. 100 m bevægelse og er den mest batterivenlige hyppige tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard. Akzeptiert häufigere Hintergrund-Updates nach etwa 100 m Bewegung und ist der akkusparendste häufigere Modus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default. Accepts frequent background updates after about 100 m of movement and is the most battery-friendly frequent mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predeterminado. Acepta actualizaciones frecuentes en segundo plano tras unos 100 m de movimiento y es el modo frecuente que ahorra más batería."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletus. Hyväksyy tiheämmät taustapäivitykset noin 100 m liikkeen jälkeen ja on akkua säästävin tiheä tila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut. Accepte les mises à jour fréquentes en arrière-plan après environ 100 m de déplacement et reste le mode fréquent le plus économe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predefinito. Accetta aggiornamenti frequenti in background dopo circa 100 m di movimento ed è la modalità frequente più efficiente per la batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準。約100 mの移動後に、より頻繁なバックグラウンド更新を受け入れます。頻繁モードの中では最も省電力です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard. Accepteert frequentere achtergrondupdates na ongeveer 100 m beweging en is de zuinigste frequente modus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认。移动约 100 米后才接受更频繁的后台更新，是频繁模式中最省电的选择。"
          }
        }
      }
    },
