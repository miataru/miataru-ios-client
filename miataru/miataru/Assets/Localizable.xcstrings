    "device_key_custom_emergency_confirm_message" : {
      "comment" : "Confirmation message for emergency identity reset",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette opretter en ny DeviceID og DeviceKey for denne app-installation. Kendte enheder med adgangskontrol skal godkende denne enhed igen. Fortsæt?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird für diese App-Installation eine neue DeviceID und ein neuer DeviceKey erzeugt. Bereits bekannte Geräte mit Zugriffskontrolle müssen dieses Gerät erneut authentifizieren. Fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This creates a new DeviceID and DeviceKey for this app install. Known devices using access control must authenticate this device again. Continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto crea una nueva DeviceID y un nuevo DeviceKey para esta instalación. Los dispositivos conocidos que usan control de acceso deberán autenticar este dispositivo de nuevo. ¿Continuar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä luo uuden DeviceID:n ja DeviceKeyn tälle asennukselle. Tunnettujen laitteiden, jotka käyttävät pääsynhallintaa, täytyy todentaa tämä laite uudelleen. Jatketaanko?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela crée un nouveau DeviceID et un nouveau DeviceKey pour cette installation. Les appareils connus qui utilisent le contrôle d’accès devront authentifier à nouveau cet appareil. Continuer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo crea un nuovo DeviceID e un nuovo DeviceKey per questa installazione. I dispositivi noti che usano il controllo accessi dovranno autenticare di nuovo questo dispositivo. Continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作で、このアプリのインストールに新しい DeviceID と DeviceKey が作成されます。アクセス制御を使用している既知のデバイスでは、このデバイスの再認証が必要になります。続行しますか？"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit maakt een nieuwe DeviceID en DeviceKey voor deze app-installatie. Bekende apparaten met toegangscontrole moeten dit apparaat opnieuw authenticeren. Doorgaan?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将为当前安装创建新的 DeviceID 和 DeviceKey。已知设备中使用访问控制的设备需要重新认证此设备。要继续吗？"
          }
        }
      }
    },
