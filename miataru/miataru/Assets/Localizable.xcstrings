    "A number of your last location updates is stored on the server (default: last 1000)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et antal af dine seneste positionsopdateringer gemmes på serveren (standard: de sidste 1000)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anzahl deiner letzten Standort-Updates wird auf dem Server gespeichert (Standard: die letzten 1000)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A number of your last location updates is stored on the server (default: last 1000)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en el servidor un número de tus últimas actualizaciones de ubicación (predeterminado: las últimas 1000)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osa viimeisimmistä sijaintipäivityksistä tallennetaan palvelimelle (oletus: viimeiset 1000)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre de vos dernières mises à jour de position est conservé sur le serveur (par défaut : les 1000 dernières)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un numero dei tuoi ultimi aggiornamenti di posizione viene salvato sul server (predefinito: gli ultimi 1000)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーにはあなたの最後の位置情報更新が一定数（デフォルト: 最新1000件）保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een aantal van je laatste locatie-updates wordt op de server opgeslagen (standaard: de laatste 1000)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器会保存你最近的一些位置更新（默认：最近 1000 条）。"
          }
        }
      }
    },
