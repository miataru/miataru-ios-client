    "Only the last location is stored for a fixed time on the server (default 30 minutes)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun den seneste placering gemmes på serveren i en fast periode (standard 30 minutter)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Server wird nur der letzte Standort für eine begrenzte Zeit gespeichert (Standard: 30 Minuten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the last location is stored for a fixed time on the server (default 30 minutes)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se guarda la última ubicación en el servidor durante un tiempo fijo (predeterminado: 30 minutos)."
