    "Only the last location is stored for a fixed time on the server (default 30 minutes).": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun den seneste placering gemmes på serveren i en fast periode (standard 30 minutter)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server wird nur der letzte Standort für eine begrenzte Zeit gespeichert (Standard: 30 Minuten)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the last location is stored for a fixed time on the server (default 30 minutes)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guarda la última ubicación en el servidor durante un tiempo fijo (predeterminado: 30 minutos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la dernière position est conservée sur le serveur pendant une durée fixe (par défaut 30 minutes)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーには最後の位置情報のみが一定期間保存されます（デフォルト: 30分）。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de laatste locatie wordt voor een vaste tijd op de server opgeslagen (standaard 30 minuten)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器只会在固定时间内保存最后一次位置（默认 30 分钟）。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain viimeinen sijainti tallennetaan palvelimelle määräajaksi (oletus 30 min)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo l'ultima posizione viene salvata sul server per un tempo fissato (predefinito 30 minuti)."
          }
        }
      }
    },
    "Open app settings in iOS to change location permission state.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn app-indstillinger i iOS for at ændre placeringstilladelsen."
