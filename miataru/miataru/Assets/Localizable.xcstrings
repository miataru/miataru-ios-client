    "explanation_auto_refresh_device_list": {
      "comment": "Explanation for auto refresh device list toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret opdateres enhedslisten automatisk, når en placeringsopdatering sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird die Geräteliste automatisch aktualisiert, sobald ein Standort-Update gesendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the device list will automatically refresh whenever a location update is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la lista de dispositivos se actualizará automáticamente cada vez que se envíe una actualización de ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la liste des appareils se rafraîchira automatiquement à chaque envoi d’une mise à jour de position."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、位置情報の更新が送信されるたびにデバイスリストが自動的に更新されます"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld wordt de apparatenlijst automatisch ververst telkens er een locatie-update wordt verzonden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，每次发送位置更新时设备列表都会自动刷新。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, laitelista päivittyy automaattisesti aina, kun sijaintipäivitys lähetetään."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la lista dispositivi si aggiorna automaticamente a ogni aggiornamento di posizione."
          }
        }
      }
    },
    "explanation_deactivate_device_lock": {
      "comment": "Explanation for deactivate device lock toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret forhindrer appen, at din enhed låser automatisk, mens Miataru er åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass das Gerät während der Nutzung dieser App automatisch gesperrt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the app will prevent your device from automatically locking while Miataru is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la app evitará que el dispositivo se bloquee automáticamente mientras Miataru está abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, l’app empêchera votre appareil de se verrouiller automatiquement pendant que Miataru est ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ使用中にデバイスが自動的にロックされるのを防ぎます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld voorkomt de app dat je apparaat automatisch vergrendelt terwijl Miataru open is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Miataru 打开时将阻止设备自动锁定。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, sovellus estää laitteen lukittumisen Miatarun ollessa auki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, l'app impedisce al dispositivo di bloccarsi automaticamente mentre Miataru è aperta."
          }
        }
      }
    },
    "explanation_indicate_location_accuracy": {
      "comment": "Explanation for indicate location accuracy toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret viser kortet den estimerede nøjagtighed af din aktuelle placering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, zeigt die Karte die geschätzte Genauigkeit deines aktuellen Standorts an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will display the estimated accuracy of your current location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el mapa mostrará la precisión estimada de tu ubicación actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte affichera la précision estimée de votre position actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、マップに現在位置の推定精度が表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld toont de kaart de geschatte nauwkeurigheid van je huidige locatie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图会显示你当前位置的估计精度。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta näyttää nykyisen sijainnin arvioidun tarkkuuden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa mostra la precisione stimata della posizione attuale."
          }
        }
      }
    },
    "explanation_map_type": {
      "comment": "Explanation for map type picker",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg kortets udseende: standard, hybrid eller satellit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle das Erscheinungsbild der Karte: Standard-, Hybrid- oder Satellitenansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the appearance of the map: standard, hybrid, or satellite view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la apariencia del mapa: estándar, híbrida o satélite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’apparence de la carte : standard, hybride ou satellite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の表示スタイルを選択してください：標準、ハイブリッド、または衛星ビュー。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies het kaarttype: standaard, hybride of satelliet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择地图外观：标准、混合或卫星。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kartan ulkoasu: vakio, hybridi tai satelliitti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli l'aspetto della mappa: standard, ibrida o satellitare."
          }
        }
      }
    },
    "explanation_map_update_interval": {
      "comment": "Explanation for map update interval picker",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv hvor ofte kortet skal opdateres og opdaterede placeringer vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie oft die Karte aktualisiert und die angezeigten Standorte erneuert werden sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set how often the map should refresh and update the displayed locations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define con qué frecuencia debe actualizarse el mapa y las ubicaciones mostradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez la fréquence de rafraîchissement de la carte et de mise à jour des positions affichées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をどの頻度で更新して位置情報を表示し直すかを設定してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel in hoe vaak de kaart moet verversen en locaties bijwerken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置地图刷新和更新显示位置的频率。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä, kuinka usein kartta päivittyy ja sijainnit päivittyvät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la frequenza con cui la mappa si aggiorna e aggiorna le posizioni mostrate."
          }
        }
      }
    },
    "explanation_map_zoom_level": {
      "comment": "Explanation for map zoom level picker",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg kortets standardzoomniveau, som afgør hvor stort område der vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Standard-Zoomfaktor der Karte, um festzulegen, wie viel Fläche sichtbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the default zoom level for the map, determining how much area is visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el nivel de zoom predeterminado del mapa, que determina cuánta área se ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le niveau de zoom par défaut de la carte, qui détermine la zone visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図のデフォルトのズームレベルを選択して、どの範囲が表示されるかを決定します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies het standaardzoomniveau van de kaart, bepaalt hoeveel gebied zichtbaar is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择地图的默认缩放级别，决定可见范围。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kartan oletuszoomaustaso, joka määrää näkyvän alueen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il livello di zoom predefinito della mappa, che determina l'area visibile."
          }
        }
      }
    },
    "explanation_navigation_auto_route_update": {
      "comment": "If enabled, the app will automatically recalculate the route while navigating when significant movement is detected.",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret beregnes ruten automatisk igen under navigation ved væsentlig bevægelse. Kan også skiftes med et langt tryk på genindlæs-knappen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird während der Navigation die Route bei signifikanter Bewegung automatisch neu berechnet. Es kann während der Navigation durch langen Druck auf den Neuladen-Button umgeschaltet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the route will be recalculated automatically during navigation when significant movement is detected. It can also be toggled via a long press on the reload button while navigating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la ruta se recalculará automáticamente durante la navegación cuando se detecte un movimiento significativo. También se puede activar con una pulsación larga en el botón de recarga durante la navegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, l’itinéraire sera recalculé automatiquement pendant la navigation lorsqu’un mouvement significatif est détecté. Peut aussi être activé par un appui long sur le bouton de rechargement pendant la navigation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ナビゲーション中に大きな移動が検出された場合、ルートが自動的に再計算されます。ナビゲーション中にリロードボタンを長押しすることで切り替え可能です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld wordt tijdens navigatie de route automatisch herberekend bij significante beweging. Kan ook met een lange druk op de herlaadknop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，导航时检测到显著移动会自动重新计算路线。导航时长按刷新按钮也可切换。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, reitti lasketaan navigoinnin aikana uudelleen merkittävän liikkeen jälkeen. Vaihda myös pitkäpainamalla päivitä-painiketta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, il percorso viene ricalcolato automaticamente durante la navigazione quando viene rilevato un movimento significativo. Puoi anche attivarlo con una pressione prolungata sul pulsante di ricarica."
          }
        }
      }
    },
    "explanation_navigation_mode": {
      "comment": "Explanation on the navigation mode selection",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg transportmåde for at beregne ruten mellem enheder. Aktiver ved at langtrykke på en enhedspin på kortet for at starte navigation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Transportmittel wählen, um die Route zwischen Geräten zu berechnen. Durch langes Drücken eines Geräte-Pins auf der Karte die Navigation starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a travel mode to calculate the route between devices. Activate by long-press a device pin on the map to start navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un modo de viaje para calcular la ruta entre dispositivos. Actívalo manteniendo pulsado un pin de dispositivo en el mapa para iniciar la navegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mode de déplacement pour calculer l’itinéraire entre les appareils. Activez-le en appuyant longuement sur une épingle d’appareil sur la carte pour démarrer la navigation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動手段を選択してデバイス間のルートを計算します。マップ上のデバイスピンを長押しするとナビゲーションが開始されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een vervoersmodus om de route tussen apparaten te berekenen. Activeer door lang op een pin te drukken om te navigeren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择出行方式以计算设备之间的路线。长按地图上的设备标记开始导航。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse matkustustapa laskeaksesi reitin laitteiden välillä. Käynnistä pitkäpainamalla kartan laiteneulaa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una modalità di viaggio per calcolare il percorso tra dispositivi. Attiva tenendo premuto un pin del dispositivo sulla mappa per avviare la navigazione."
          }
        }
      }
    },
    "explanation_pulsating_map_markers": {
      "comment": "Explanation for pulsating map markers toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret viser kortmarkører en subtil pulserende og glimtende animation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, zeigen Kartenmarkierungen eine dezente pulsierende und schimmernde Animation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, map markers will show a subtle pulsating and shimmering animation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, los marcadores del mapa mostrarán una animación sutil de pulso y brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, les marqueurs de carte afficheront une animation subtile de pulsation et de scintillement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、マップマーカーに控えめな鼓動およびシマーのアニメーションが表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld tonen kaartmarkeringen een subtiele puls- en glimeffect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图标记将显示轻微脉冲和闪光动画。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, karttamerkit näyttävät hienovaraisen pulssi- ja kimmellysanimaation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, i marker della mappa mostreranno una leggera animazione pulsante e scintillante."
          }
        }
      }
    },
    "explanation_reverse_geocoding_threshold": {
      "comment": "Explanation for reverse geocoding distance threshold",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindste afstandsændring før adressen opdateres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab welcher Distanzänderung die Adresse neu ermittelt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum distance change before address is refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio mínimo de distancia antes de actualizar la dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changement de distance minimal avant la mise à jour de l’adresse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小距離変化でアドレス更新"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimale afstandsverandering voordat adres wordt vernieuwd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址刷新前的最小距离变化。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähimmäismatkan muutos ennen osoitteen päivitystä."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanza minima di cambiamento prima di aggiornare l'indirizzo."
          }
        }
      }
    },
    "explanation_show_history_days": {
      "comment": "Explanation for show history days picker",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg hvor mange dages historik der skal vises på kortet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, wie viele Tage Standortverlauf auf der Karte angezeigt werden sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select how many days of location history should be shown on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona cuántos días de historial deben mostrarse en el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le nombre de jours d’historique à afficher sur la carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図に表示する位置情報履歴の日数を選択してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoeveel dagen locatiegeschiedenis op de kaart wordt getoond."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择地图上显示多少天的位置历史。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, kuinka monta päivää historiaa näytetään kartalla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona quanti giorni di cronologia mostrare sulla mappa."
          }
        }
      }
    },
    "explanation_show_offscreen_arrows_for_other_devices": {
      "comment": "Explanation for show offscreen arrows for other devices toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret viser kortet pile til andre kendte enheder uden for det synlige område. Når de er synlige, vises de på kortet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden auf der Karte Pfeile angezeigt, die auf andere bekannte Geräte zeigen, die sich außerhalb des sichtbaren Bereichs befinden. Wenn sich diese Geräte im sichtbaren Bereich befinden, werden sie auf der Karte angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will show arrows pointing to other known devices that are located outside the visible area. When these devices are in the visible area they will be shown on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el mapa mostrará flechas que apuntan a otros dispositivos conocidos situados fuera del área visible. Cuando estén dentro del área visible se mostrarán en el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte affichera des flèches vers d’autres appareils connus situés hors de la zone visible. Quand ces appareils sont visibles, ils s’affichent sur la carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、マップに表示範囲外にある他の既知のデバイスを指す矢印が表示されます。それらのデバイスが表示範囲内にある場合は、地図上に表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld toont de kaart pijlen naar andere bekende apparaten buiten beeld. Binnen beeld worden ze getoond."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图会显示指向可见范围外其他已知设备的箭头；在可见范围内则显示设备。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta näyttää nuolet muihin tunnetuihin laitteisiin näkyvän alueen ulkopuolella. Näkyvissä ollessaan ne näytetään kartalla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa mostra frecce verso altri dispositivi noti fuori dall'area visibile. Quando sono visibili, appaiono sulla mappa."
          }
        }
      }
    },
    "explanation_show_route_progress": {
      "comment": "Explanation for show route progress toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret farver kortet ruten for at indikere, hvor langt den anden enhed sandsynligvis er nået siden sidste opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, färbt die Karte die Route ein, um anzuzeigen, wie weit sich das andere Gerät seit seinem letzten Update wahrscheinlich bewegt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will color the route to indicate how far the other device has likely traveled since its last update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, el mapa coloreará la ruta para indicar cuánto ha avanzado probablemente el otro dispositivo desde su última actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte colorera l’itinéraire pour indiquer jusqu’où l’autre appareil a probablement avancé depuis sa dernière mise à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、地図上のルートに色が付き、前回の更新以降に相手のデバイスがどれだけ移動した可能性があるかを示します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld kleurt de kaart de route om te tonen hoe ver het andere apparaat waarschijnlijk is gekomen sinds de laatste update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图会用颜色标示自上次更新以来另一设备可能前进的路程。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta värittää reitin näyttääkseen, kuinka pitkälle toinen laite on todennäköisesti edennyt viime päivityksen jälkeen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa colorerà il percorso per indicare quanto è probabilmente avanzato l'altro dispositivo dall'ultimo aggiornamento."
          }
        }
      }
    },
    "explanation_zoom_to_fit_for_groups": {
      "comment": "Explanation for zoom to fit for groups toggle",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis aktiveret justerer kortet automatisk zoom for at vise alle gruppemedlemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, passt die Karte den Zoom automatisch an, um alle Gruppenmitglieder gleichzeitig anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the map will automatically adjust the zoom to show all group members at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activé, el mapa ajustará automáticamente el zoom para mostrar a todos los miembros del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la carte ajustera automatiquement le zoom pour afficher tous les membres du groupe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、地図のズームが自動的に調整され、全てのグループメンバーが一度に表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld past de kaart automatisch het zoomniveau aan om alle groepsleden te tonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，地图将自动调整缩放以一次显示所有组成员。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käytössä, kartta säätää zoomin automaattisesti näyttämään kaikki ryhmän jäsenet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, la mappa adatterà automaticamente lo zoom per mostrare tutti i membri del gruppo."
          }
        }
      }
    },
    "Finish": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizar"
          }
        },
