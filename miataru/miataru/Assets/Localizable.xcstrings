    "frequent_background_visitor_check_every_update_explanation" : {
      "comment" : "Explanation for every-update visitor-history checks in frequent background mode",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visitorhistorikken hentes efter hver accepteret baggrundsopdatering. Det er mest aktuelt, men bruger mest netværk og batteri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Besucherhistorie wird nach jedem akzeptierten Hintergrund-Update abgefragt. Das ist am aktuellsten, nutzt aber am meisten Netzwerk und Akku."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visitor history is requested after every accepted background update. This is the freshest option, but uses the most network and battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de visitantes se solicita después de cada actualización en segundo plano aceptada. Es la opción más actual, pero usa más red y batería."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierailijahistoria haetaan jokaisen hyväksytyn taustapäivityksen jälkeen. Tämä on ajantasaisin vaihtoehto, mutta käyttää eniten verkkoa ja akkua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique des visiteurs est demandé après chaque mise à jour en arrière-plan acceptée. C’est l’option la plus à jour, mais elle utilise le plus de réseau et de batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia visitatori viene richiesta dopo ogni aggiornamento in background accettato. È l’opzione più aggiornata, ma usa più rete e batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受け入れられた各バックグラウンド更新の後に訪問者履歴を取得します。最も新しい状態を保てますが、通信とバッテリーを最も使います。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bezoekersgeschiedenis wordt na elke geaccepteerde achtergrondupdate opgevraagd. Dit is het meest actueel, maar gebruikt de meeste netwerk- en batterijcapaciteit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次已接受的后台更新后都会请求访客历史。这是最新的选项，但会使用最多网络和电量。"
          }
        }
      }
    },
