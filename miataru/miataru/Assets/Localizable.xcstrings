    "frequent_background_location_updates_explanation" : {
      "comment" : "Explanation for frequent background location updates",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når denne tilstand er slået fra, bruger Miataru den nuværende batteribesparende significant-change-tilstand. Når den er slået til, forsøger appen at levere opdateringer efter den valgte bevægelsestærskel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option ausgeschaltet ist, nutzt Miataru den bisherigen energiesparenden Significant-Change-Modus. Wenn sie eingeschaltet ist, versucht die App, Updates ab der gewählten Bewegungsschwelle zu liefern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is off, Miataru keeps using the current battery-saving significant-change mode. When it is on, the app tries to deliver updates after the selected movement threshold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está desactivado, Miataru sigue usando el modo actual de ahorro de batería con cambios significativos. Cuando está activado, la app intenta entregar actualizaciones después del umbral de movimiento elegido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on pois käytöstä, Miataru käyttää nykyistä akkua säästävää significant-change-tilaa. Kun se on käytössä, sovellus yrittää toimittaa päivityksiä valitun liikkumiskynnyksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est désactivée, Miataru conserve le mode actuel économe en batterie basé sur les changements significatifs. Lorsqu’elle est activée, l’app essaie d’envoyer des mises à jour après le seuil de déplacement choisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando questa opzione è disattivata, Miataru continua a usare l’attuale modalità a risparmio batteria basata sui cambiamenti significativi. Quando è attiva, l’app prova a inviare aggiornamenti dopo la soglia di movimento scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合、Miataru は現在の省電力な Significant-Change モードを使い続けます。オンの場合、選択した移動しきい値を超えた後に更新を届けようとします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit uit staat, blijft Miataru de huidige batterijbesparende significant-change-modus gebruiken. Als dit aan staat, probeert de app updates te leveren na de gekozen bewegingsdrempel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，Miataru 会继续使用当前省电的显著位置变化模式。开启时，应用会尝试在达到所选移动阈值后发送更新。"
          }
        }
      }
    },
