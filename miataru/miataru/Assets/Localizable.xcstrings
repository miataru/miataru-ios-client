    "background_location_distance_filter_25m_explanation" : {
      "comment" : "Explanation for 25 m frequent background movement threshold",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mest responsiv. Accepterer opdateringer efter ca. 25 m og kan bruge mest batteri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am reaktionsschnellsten. Akzeptiert Updates nach etwa 25 m und kann am meisten Akku verbrauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most responsive. Accepts updates after about 25 m and can use the most battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El más sensible. Acepta actualizaciones tras unos 25 m y puede consumir la mayor cantidad de batería."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reagoi nopeimmin. Hyväksyy päivitykset noin 25 m jälkeen ja voi kuluttaa eniten akkua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus réactif. Accepte des mises à jour après environ 25 m et peut consommer le plus de batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massima reattività. Accetta aggiornamenti dopo circa 25 m e può consumare più batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も反応が速い設定です。約25 mの移動後に更新を受け入れ、最もバッテリーを消費する場合があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reageert het snelst. Accepteert updates na ongeveer 25 m en kan de meeste batterij gebruiken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "响应最快。移动约 25 米后接受更新，可能消耗最多电量。"
          }
        }
      }
    },
