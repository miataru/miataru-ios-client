    "You can change your settings or permissions anytime in the app." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan altid ændre dine indstillinger eller tilladelser i appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deine Einstellungen oder Berechtigungen jederzeit in der App ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change your settings or permissions anytime in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar tus ajustes o permisos en cualquier momento en la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit muuttaa asetuksia tai lupia milloin tahansa sovelluksessa."
          }
