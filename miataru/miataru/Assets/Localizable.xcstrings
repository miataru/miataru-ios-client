    "allowed_device_list_intro_text" : {
      "comment" : "Introductory text explaining the allowed device list feature",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver valgfrit adgangskontrol for linkede enheder. Du kan definere pr. enhed, om nuværende position og positionshistorik deles. Dette kræver en DeviceKey og kan ikke slås fra senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional Zugriffskontrolle für verknüpfte Geräte aktivieren. Sie können pro Gerät festlegen, ob aktuelle Position und Positionsverlauf geteilt werden. Dies erfordert einen DeviceKey und kann später nicht deaktiviert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionally enable access control for linked devices. You can define per device whether current location and location history are shared. This requires a DeviceKey and cannot be turned off later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionalmente habilita el control de acceso para dispositivos vinculados. Puedes definir por dispositivo si se comparten la ubicación actual y el historial de ubicaciones. Esto requiere un DeviceKey y no se puede desactivar más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit valinnallisesti ottaa käyttöoikeuksien hallinnan käyttöön linkitetyille laitteille. Voit määrittää laitteittain, jaetaanko nykyinen sijainti ja sijaintihistoria. Tämä vaatii DeviceKeyn ja sitä ei voi poistaa käytöstä myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez optionnellement le contrôle d'accès pour les appareils liés. Vous pouvez définir par appareil si la position actuelle et l'historique des positions sont partagés. Cela nécessite un DeviceKey et ne peut pas être désactivé plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita opzionalmente il controllo di accesso per i dispositivi collegati. Puoi definire per dispositivo se condividere la posizione corrente e la cronologia delle posizioni. Questo richiede un DeviceKey e non può essere disattivato in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクされたデバイスのアクセス制御をオプションで有効にできます。デバイスごとに現在地と位置履歴を共有するかどうかを定義できます。これにはDeviceKeyが必要で、後でオフにすることはできません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel toegangscontrole inschakelen voor gekoppelde apparaten. U kunt per apparaat definiëren of de huidige locatie en locatiegeschiedenis worden gedeeld. Dit vereist een DeviceKey en kan later niet worden uitgeschakeld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选地为链接的设备启用访问控制。您可以按设备定义是否共享当前位置和位置历史记录。这需要设备密钥，以后无法关闭。"
          }
        }
      }
    },
    "allowed_device_list_section_title" : {
      "comment" : "Section header for allowed device list in settings",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhedsadgangskontrol"
