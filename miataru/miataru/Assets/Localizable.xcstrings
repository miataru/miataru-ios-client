    "Miataru needs your location to provide core app functionality, such as sharing your position with trusted contacts." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru har brug for din placering for at levere kernefunktioner, som at dele din position med betroede kontakter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru benötigt deinen Standort, um Kernfunktionen der App bereitzustellen, z. B. das Teilen deiner Position mit vertrauenswürdigen Kontakten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru needs your location to provide core app functionality, such as sharing your position with trusted contacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru necesita tu ubicación para ofrecer funciones básicas como compartir tu posición con contactos de confianza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru tarvitsee sijaintisi tarjotakseen ydintoiminnot, kuten sijainnin jakamisen luotettujen kontaktien kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru a besoin de votre position pour fournir ses fonctionnalités principales, comme partager votre position avec des contacts de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru ha bisogno della tua posizione per fornire le funzioni principali, come condividere la posizione con contatti fidati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataruは、信頼できる連絡先と位置情報を共有するなど、アプリの主要な機能を提供するためにあなたの位置情報が必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru heeft je locatie nodig voor kernfunctionaliteit, zoals het delen van je positie met vertrouwde contacten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miataru 需要你的位置信息来提供核心功能，例如与可信联系人分享位置。"
          }
        }
      }
    },
