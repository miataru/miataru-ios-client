    "10000" : {
      "comment" : "A value for the location update outbox retention setting.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "A number of your last location updates is stored on the server (default: last 1000)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et antal af dine seneste positionsopdateringer gemmes på serveren (standard: de sidste 1000)."
