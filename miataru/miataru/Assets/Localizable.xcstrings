          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abilitato, i marker della mappa mostreranno una leggera animazione pulsante e scintillante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、マップマーカーに控えめな鼓動およびシマーのアニメーションが表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
