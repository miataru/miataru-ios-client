          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、マップマーカーに控えめな鼓動およびシマーのアニメーションが表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
