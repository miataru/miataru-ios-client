    "Location updates in the background are only detected when they are significant (>500m)." : {
      "comment" : "Hint for background location update behavior",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokationsopdateringer i baggrunden registreres kun, når de er betydelige (>500 m)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort-Updates im Hintergrund werden nur erkannt, wenn sie signifikant sind (>500 m)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location updates in the background are only detected when they are significant (>500m)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones de ubicación en segundo plano solo se detectan cuando son significativas (>500 m)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustasijainti päivittyy vain merkittävässä liikkeessä (>500 m)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour de localisation en arrière-plan ne sont détectées que lorsqu’elles sont significatives (>500 m)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti di posizione in background vengono rilevati solo se significativi (>500 m)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドでの位置情報更新は、重要な変化（>500m）があった場合にのみ検出されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatie-updates op de achtergrond worden alleen gedetecteerd als ze significant zijn (>500 m)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台位置更新仅在变动明显时检测（>500 米）。"
          }
        }
      }
    },
