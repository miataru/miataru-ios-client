    "Location updates in the background are only detected when they are significant (>500m).": {
      "comment": "Hint for background location update behavior",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokationsopdateringer i baggrunden registreres kun, når de er betydelige (>500 m)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort-Updates im Hintergrund werden nur erkannt, wenn sie signifikant sind (>500 m)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location updates in the background are only detected when they are significant (>500m)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones de ubicación en segundo plano solo se detectan cuando son significativas (>500 m)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour de localisation en arrière-plan ne sont détectées que lorsqu’elles sont significatives (>500 m)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでの位置情報更新は、重要な変化（>500m）があった場合にのみ検出されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie-updates op de achtergrond worden alleen gedetecteerd als ze significant zijn (>500 m)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台位置更新仅在变动明显时检测（>500 米）。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustasijainti päivittyy vain merkittävässä liikkeessä (>500 m)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti di posizione in background vengono rilevati solo se significativi (>500 m)."
          }
        }
      }
    },
    "location_sensitivity_explanation": {
      "comment": "Explanation for location sensitivity picker",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne indstilling styrer, hvor følsomt placeringer sendes til serveren, kombinerer afstands- og nøjagtighedsændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Option legt fest, wie empfindlich die App auf Änderungen der Standortgenauigkeit im Vergleich zur letzten Aktualisierung reagiert und wie häufig Standort-Updates angefordert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This option determines the sensitivity of how often location updates are sent to the server. It's a combination of how much distance and accuracy of the location has changed compared to the last update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opción determina la sensibilidad con la que se envían las actualizaciones de ubicación al servidor. Combina el cambio de distancia y de precisión respecto a la última actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette option détermine la sensibilité de l’envoi des mises à jour de position au serveur. Elle combine le changement de distance et de précision par rapport à la dernière mise à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオプションは、前回の更新と比較して位置情報の精度がどの程度変化したかに応じて、位置情報更新を要求する感度を決定します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze optie bepaalt hoe gevoelig locatie-updates naar de server worden gestuurd. Het combineert afstands- en nauwkeurigheidsverandering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选项决定向服务器发送位置更新的敏感度，综合距离和精度的变化。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä asetus määrittää, kuinka herkästi sijaintipäivitykset lähetetään palvelimelle. Se yhdistää matka- ja tarkkuusmuutoksen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa opzione determina la sensibilità con cui gli aggiornamenti di posizione vengono inviati al server. Combina variazione di distanza e precisione."
          }
        }
      }
    },
