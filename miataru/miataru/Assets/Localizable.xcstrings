    "Miataru helps you share your (device) location with people and groups you trust.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru hjælper dig med at dele din (enheds)placering med personer og grupper, du stoler på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru hilft dir, deinen (Geräte-)Standort mit Personen und Gruppen zu teilen, denen du vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru helps you share your (device) location with people and groups you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru te ayuda a compartir la ubicación de tu dispositivo con personas y grupos de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru vous aide à partager la position de votre appareil avec des personnes et des groupes de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruは信頼できる人やグループとデバイスの位置情報を共有するのに役立ちます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru helpt je je (apparaat)locatie te delen met mensen en groepen die je vertrouwt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 帮助你与信任的人和群组共享（设备）位置。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru auttaa jakamaan (laitteen) sijaintisi luotettujen ihmisten ja ryhmien kanssa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ti aiuta a condividere la posizione (del dispositivo) con persone e gruppi di cui ti fidi."
          }
        }
      }
    },
    "Miataru is set up and ready.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru er sat op og klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ist eingerichtet und bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is set up and ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru está configurado y listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru est configuré et prêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruは設定され、使用可能です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru is ingesteld en klaar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 已设置完毕，准备就绪。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru on asetettu ja valmis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru è configurata e pronta."
          }
        }
      }
    },
    "Miataru needs your location to provide core app functionality, such as sharing your position with trusted contacts.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru har brug for din placering for at levere kernefunktioner, som at dele din position med betroede kontakter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru benötigt deinen Standort, um Kernfunktionen der App bereitzustellen, z. B. das Teilen deiner Position mit vertrauenswürdigen Kontakten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru needs your location to provide core app functionality, such as sharing your position with trusted contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru necesita tu ubicación para ofrecer funciones básicas como compartir tu posición con contactos de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru a besoin de votre position pour fournir ses fonctionnalités principales, comme partager votre position avec des contacts de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataruは、信頼できる連絡先と位置情報を共有するなど、アプリの主要な機能を提供するためにあなたの位置情報が必要です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru heeft je locatie nodig voor kernfunctionaliteit, zoals het delen van je positie met vertrouwde contacten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru 需要你的位置信息来提供核心功能，例如与可信联系人分享位置。"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru tarvitsee sijaintisi tarjotakseen ydintoiminnot, kuten sijainnin jakamisen luotettujen kontaktien kanssa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miataru ha bisogno della tua posizione per fornire le funzioni principali, come condividere la posizione con contatti fidati."
          }
        }
      }
    },
